b \u0938\u094d\u0915\u094d\u0930\u0949\u0932",AUDIO:"\u0911\u0921\u093f\u092f\u094b \u092a\u094d\u0932\u0947\u092f\u0930",AUDIO_AUTO_PLAY:"\u0911\u0921\u093f\u092f\u094b \u0911\u091f\u094b \u092a\u094d\u0932\u0947",AUDIO_SYNC_SCROLL:"\u0911\u0921\u093f\u092f\u094b \u0915\u0947 \u0938\u093e\u0925 \u0938\u094d\u0915\u094d\u0930\u0949\u0932 \u0938\u093f\u0902\u0915 \u0915\u0930\u0947\u0902",DEFAULT_AUDIO:"\u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0911\u0921\u093f\u092f\u094b",bani_length:"\u092c\u093e\u0923\u0940 \u0932\u0902\u092c\u093e\u0908",bani_font_face:"\u092c\u093e\u0923\u0940 \u092b\u0949\u0928\u094d\u091f",bani_length_alert_1:"\u092a\u093f\u091b\u0932\u0947 \u0915\u0941\u091b \u0938\u0926\u093f\u092f\u094b\u0902 \u092e\u0947\u0902, \u0915\u0908 \u0938\u092e\u094d\u092a\u094d\u0930\u0926\u093e\u092f\u0947\u0902 \u0914\u0930 \u0938\u0902\u0917\u0920\u0928 \u092a\u0948\u0926\u093e \u0939\u0941\u0908 \u0939\u0948\u0902, \u091c\u094b \u0938\u093f\u0916 \u0938\u093f\u0926\u094d\u0927\u093e\u0902\u0924 \u0914\u0930 \u0917\u0941\u0930\u0941\u092e\u0924 \u092a\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0939\u0948\u0902\u0964 \u0939\u093e\u0932\u093e\u0902\u0915\u093f \u0907\u0928 \u0938\u0902\u092a\u094d\u0930\u0926\u093e\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u093f\u0916 \u0907\u0924\u093f\u0939\u093e\u0938, \u0917\u0941\u0930\u092c\u093e\u0928\u0940 \u0914\u0930 \u0905\u0928\u0941\u092a\u093e\u0932\u0928 \u092a\u0930 \u092e\u0924\u092d\u0947\u0926 \u0930\u0939\u0947 \u0939\u0948\u0902, \u092a\u0930 \u0935\u0947 \u092a\u0942\u0930\u094d\u0923 \u0930\u0942\u092a \u0938\u0947  \u0916\u093e\u0932\u0938\u093e \u092a\u0902\u0925 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u0928\u0947 \u0939\u0941\u090f \u0939\u0948\u0902 \u0914\u0930 \u0909\u091a\u094d\u091a\u0924\u092e \u0905\u0915\u093e\u0932 \u0924\u0916\u094d\u0924 \u0915\u0947 \u092c\u0948\u0928\u0930 \u0924\u0932\u0947 \u0939\u0940 \u0930\u0939 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964",bani_length_alert_2:"\u0907\u0928 \u092e\u0924\u092d\u0947\u0926\u094b\u0902 \u0915\u0947 \u0915\u093e\u0930\u0923, \u0928\u093f\u0924\u0928\u0947\u092e \u0915\u0940 \u092c\u093e\u0923\u093f\u0913\u0902  \u0915\u0940 \u0932\u0902\u092c\u093e\u0908 \u092a\u0930 \u0905\u0932\u0917- \u0905\u0932\u0917 \u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u092e\u093f\u0932\u0924\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938 \u0915\u093e\u0930\u0923 \u0938\u0947, \u0939\u0930 \u090f\u0915 \u0915\u094b \u0938\u0902\u0924\u0941\u0937\u094d\u091f \u0915\u0930 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u093e \u090f\u0915  \u0938\u0941\u0902\u0926\u0930 \u0917\u0941\u091f\u0915\u093e \u0910\u092a \u092c\u0928\u093e\u0928\u093e \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0939\u0948\u0964",bani_length_alert_3:"\u0907\u0938\u0940\u0932\u093f\u090f \u0939\u092e\u0928\u0947 \u0907\u0938 \u0910\u092a \u092e\u0947\u0902 \u091a\u093e\u0930 \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092a\u0922\u093c\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u092c\u093e\u0923\u093f\u0913\u0902 \u0915\u0940 \u0932\u0902\u092c\u093e\u0908 \u091a\u0941\u0928\u0928\u0947 \u0915\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u0926\u0940 \u0939\u0948\u0964 \u0907\u0928 \u091a\u092f\u0928\u094b\u0902 \u0915\u094b \u092c\u093e\u0923\u0940 \u0915\u0940 \u0932\u0902\u092c\u093e\u0908 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u0938\u092d\u0940 \u092c\u093e\u0923\u0940 \u0905\u0915\u093e\u0932 \u0924\u0916\u094d\u0924 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0928\u0941\u092e\u094b\u0926\u093f\u0924 \u092e\u093e\u0928\u0915\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0939\u0948\u0902\u0964 \u0939\u092e\u0928\u0947 \u0907\u0938 \u090f\u092a \u092e\u0947\u0902 \u0905\u0915\u093e\u0932 \u0924\u0916\u094d\u0924 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0902\u0925 \u0938\u0947 \u092c\u093e\u0939\u0930 \u0915\u0940 \u0939\u0941\u0908 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u0902\u092a\u094d\u0930\u0926\u093e\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u090f \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u092c\u093e\u0923\u0940 \u0928\u0939\u0940\u0902 \u0936\u093e\u092e\u093f\u0932 \u0915\u0940 \u0939\u0948\u0964",bani_length_alert_4:"\u092f\u0926\u093f \u0906\u092a \u0905\u0938\u092e\u0902\u091c\u0938 \u092e\u0947\u0902 \u0939\u0948\u0902 \u0915\u093f \u0915\u093f\u0938 \u092c\u093e\u0923\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902, \u0924\u094b \u0939\u092e\u093e\u0930\u0940 \u0938\u0932\u093e\u0939 \u0938\u092c\u0938\u0947 \u0932\u0902\u092c\u0940 \u092c\u093e\u0923\u0940 \u0939\u0948 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u091c\u093f\u0924\u0928\u093e \u0905\u0927\u093f\u0915 \u0939\u092e \u092c\u093e\u0923\u0940 \u0915\u093e \u0905\u092d\u094d\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0917\u0947, \u0939\u092e\u093e\u0930\u0940 \u0906\u0924\u094d\u092e\u093e \u0915\u0947 \u0932\u093f\u090f \u0909\u0924\u0928\u093e \u0939\u0940 \u0905\u091a\u094d\u091b\u093e \u0939\u094b\u0917\u093e\u0964 \u092f\u0926\u093f \u0906\u092a \u090f\u0915\u0926\u092e \u0928\u090f \u0939\u0948\u0902 \u0924\u094b \u0906\u092a \u0938\u092c\u0938\u0947 \u091b\u094b\u091f\u0940 \u092c\u093e\u0923\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0936\u0941\u0930\u0941\u0906\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u091c\u0948\u0938\u0947 \u0906\u092a\u0915\u093e \u0928\u093e\u092e \u0905\u092d\u094d\u092f\u093e\u0938 \u092c\u095d\u0924\u093e \u0939\u0948, \u0906\u092a \u0905\u0927\u093f\u0915 \u092c\u093e\u0923\u0940 \u092a\u0922\u093c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",bani_length_alert_5:"\u092c\u093e\u0923\u093f\