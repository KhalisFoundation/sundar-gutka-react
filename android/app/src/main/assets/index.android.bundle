__d(function(a,e,n,i,r,t,h){r.exports={_generated:"2026-06-18",_source:"api.banidb.com/v2/random",count:100,shabads:[{lines:["\u0a2b\u0a30\u0a40\u0a26\u0a3e \u0a2a\u0a3e\u0a5c\u0a3f \u0a2a\u0a1f\u0a4b\u0a32\u0a3e \u0a27\u0a1c \u0a15\u0a30\u0a40 \u0a15\u0a70\u0a2c\u0a32\u0a5c\u0a40 \u0a2a\u0a39\u0a3f\u0a30\u0a47\u0a09 \u0965","\u0a1c\u0a3f\u0a28\u0a51\u0a40 \u0a35\u0a47\u0a38\u0a40 \u0a38\u0a39\u0a41 \u0a2e\u0a3f\u0a32\u0a48 \u0a38\u0a47\u0a08 \u0a35\u0a47\u0a38 \u0a15\u0a30\u0a47\u0a09 \u0965\u0a67\u0a66\u0a69\u0965"],translation:"Fareed, I have torn my clothes to tatters; now I wear only a rough blanket.",transliteration:["fareedhaa paaR paTolaa dhaj karee ka(n)balaRee pahireau ||","jin(h)ee vesee sahu milai seiee ves kareau ||103||"],raag:"\u0a38\u0a32\u0a4b\u0a15 \u0a38\u0a47\u0a16 \u0a2b\u0a30\u0a40\u0a26 \u0a15",ang:1383,shabadId:5311},{lines:["\u0a28\u0a3e\u0a28\u0a15 \u0a35\u0a40\u0a1a\u0a3e\u0a30\u0a39\u0a3f \u0a38\u0a70\u0a24 \u0a2e\u0a41\u0a28\u0a3f \u0a1c\u0a28\u0a3e\u0a02 \u0a1a\u0a3e\u0a30\u0a3f \u0a35\u0a47\u0a26 \u0a15\u0a39\u0a70\u0a26\u0a47 \u0965","\u0a2d\u0a17\u0a24 \u0a2e\u0a41\u0a16\u0a48 \u0a24\u0a47 \u0a2c\u0a4b\u0a32\u0a26\u0a47 \u0a38\u0a47 \u0a35\u0a1a\u0a28 \u0a39\u0a4b\u0a35\u0a70\u0a26\u0a47 \u0965"],translation:"O Nanak, the Saints and the silent sages think, and the four Vedas proclaim,",transliteration:["naanak veechaareh sa(n)t mun janaa(n) chaar vedh kaha(n)dhe ||","bhagat mukhai te boladhe se vachan hova(n)dhe ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:316,shabadId:1215},{lines:["\u0a32\u0a3e\u0a32 \u0a30\u0a70\u0a17\u0a41 \u0a24\u0a3f\u0a38 \u0a15\u0a09 \u0a32\u0a17\u0a3e \u0a1c\u0a3f\u0a38 \u0a15\u0a47 \u0a35\u0a21\u0a2d\u0a3e\u0a17\u0a3e \u0965","\u0a2e\u0a48\u0a32\u0a3e \u0a15\u0a26\u0a47 \u0a28 \u0a39\u0a4b\u0a35\u0a08 \u0a28\u0a39 \u0a32\u0a3e\u0a17\u0a48 \u0a26\u0a3e\u0a17\u0a3e \u0965\u0a67\u0965"],translation:"One is dyed in the color of the Lord's Love, by great good fortune.",transliteration:["laal ra(n)g tis kau lagaa jis ke vaddabhaagaa ||","mailaa kadhe na hoviee neh laagai dhaagaa ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a3f\u0a32\u0a3e\u0a35\u0a32",ang:808,shabadId:3039},{lines:["\u0a2a\u0a3e\u0a30\u0a2c\u0a4d\u0a30\u0a39\u0a2e \u0a38\u0a2d \u0a0a\u0a1a \u0a2c\u0a3f\u0a30\u0a3e\u0a1c\u0a47 \u0965","\u0a06\u0a2a\u0a47 \u0a25\u0a3e\u0a2a\u0a3f \u0a09\u0a25\u0a3e\u0a2a\u0a47 \u0a38\u0a3e\u0a1c\u0a47 \u0965"],translation:"The Abode of the Supreme Lord God is above all.",transliteration:["paarabraham sabh uooch biraaje ||","aape thaap uthaape saaje ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a3e\u0a30\u0a42",ang:1084,shabadId:3796},{lines:["\u0a05\u0a2e\u0a32\u0a41 \u0a17\u0a32\u0a4b\u0a32\u0a3e \u0a15\u0a42\u0a5c \u0a15\u0a3e \u0a26\u0a3f\u0a24\u0a3e \u0a26\u0a47\u0a35\u0a23\u0a39\u0a3e\u0a30\u0a3f \u0965","\u0a2e\u0a24\u0a40 \u0a2e\u0a30\u0a23\u0a41 \u0a35\u0a3f\u0a38\u0a3e\u0a30\u0a3f\u0a06 \u0a16\u0a41\u0a38\u0a40 \u0a15\u0a40\u0a24\u0a40 \u0a26\u0a3f\u0a28 \u0a1a\u0a3e\u0a30\u0a3f \u0965"],translation:"The Great Giver has given the intoxicating drug of falsehood.",transliteration:["amal galolaa kooR kaa dhitaa dhevanahaar ||","matee maran visaariaa khusee keetee dhin chaar ||"],raag:"\u0a38\u0a3f\u0a30\u0a40 \u0a30\u0a3e\u0a17\u0a41",ang:15,shabadId:58},{lines:["\u0a07\u0a70\u0a26\u0a4d\u0a30 \u0a32\u0a4b\u0a15 \u0a38\u0a3f\u0a35 \u0a32\u0a4b\u0a15\u0a39\u0a3f \u0a1c\u0a48\u0a2c\u0a4b \u0965","\u0a13\u0a1b\u0a47 \u0a24\u0a2a \u0a15\u0a30\u0a3f \u0a2c\u0a3e\u0a39\u0a41\u0a30\u0a3f \u0a10\u0a2c\u0a4b \u0965\u0a67\u0965"],translation:"Mortals may go to the Realm of Indra, or the Realm of Shiva,",transliteration:["ei(n)dhr lok siv lokeh jaibo ||","ochhe tap kar baahur aaibo ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a27\u0a28\u0a3e\u0a38\u0a30\u0a40",ang:692,shabadId:2629},{lines:["\u0a15\u0a2c\u0a40\u0a30 \u0a17\u0a30\u0a2c\u0a41 \u0a28 \u0a15\u0a40\u0a1c\u0a40\u0a10 \u0a1a\u0a3e\u0a2e \u0a32\u0a2a\u0a47\u0a1f\u0a47 \u0a39\u0a3e\u0a21 \u0965","\u0a39\u0a48\u0a35\u0a30 \u0a0a\u0a2a\u0a30\u0a3f \u0a1b\u0a24\u0a4d\u0a30 \u0a24\u0a30 \u0a24\u0a47 \u0a2b\u0a41\u0a28\u0a3f \u0a27\u0a30\u0a28\u0a40 \u0a17\u0a3e\u0a21 \u0965\u0a69\u0a6d\u0965"],translation:"Kabeer, do not be so proud of your bones wrapped up in skin.",transliteration:["kabeer garab na keejeeaai chaam lapeTe haadd ||","haivar uoopar chhatr tar te fun dharanee gaadd ||37||"],raag:"\u0a38\u0a32\u0a4b\u0a15 \u0a2d\u0a17\u0a24 \u0a15\u0a2c\u0a40\u0a30 \u0a1c\u0a40\u0a09 \u0a15\u0a47",ang:1366,shabadId:5005},{lines:["\u0a05\u0a70\u0a24\u0a30\u0a3f \u0a39\u0a30\u0a3f \u0a17\u0a41\u0a30\u0a42 \u0a27\u0a3f\u0a06\u0a07\u0a26\u0a3e \u0a35\u0a21\u0a40 \u0a35\u0a21\u0a3f\u0a06\u0a08 \u0965","\u0a24\u0a41\u0a38\u0a3f \u0a26\u0a3f\u0a24\u0a40 \u0a2a\u0a42\u0a30\u0a48 \u0a38\u0a24\u0a3f\u0a17\u0a41\u0a30\u0a42 \u0a18\u0a1f\u0a48 \u0a28\u0a3e\u0a39\u0a40 \u0a07\u0a15\u0a41 \u0a24\u0a3f\u0a32\u0a41 \u0a15\u0a3f\u0a38\u0a48 \u0a26\u0a40 \u0a18\u0a1f\u0a3e\u0a08 \u0965"],translation:"Great is the greatness of the Guru, who meditates on the Lord within.",transliteration:["a(n)tar har guroo dhiaaidhaa vaddee vaddiaaiee ||","tus dhitee poorai satiguroo ghaTai naahee ik til kisai dhee ghaTaiee ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:306,shabadId:1157},{lines:["\u0a26\u0a30\u0a38\u0a28 \u0a15\u0a40 \u0a2a\u0a3f\u0a06\u0a38 \u0a1c\u0a3f\u0a38\u0a41 \u0a28\u0a30 \u0a39\u0a4b\u0a07 \u0965","\u0a0f\u0a15\u0a24\u0a41 \u0a30\u0a3e\u0a1a\u0a48 \u0a2a\u0a30\u0a39\u0a30\u0a3f \u0a26\u0a4b\u0a07 \u0965"],translation:"That person, who thirsts for the Blessed Vision of the Lord's Darshan,",transliteration:["dharasan kee piaas jis nar hoi ||","ekat raachai parahar dhoi ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a38\u0a70\u0a24",ang:1188,shabadId:4225},{lines:["\u0a06\u0a2a\u0a47 \u0a2c\u0a16\u0a38\u0a47 \u0a26\u0a07\u0a06 \u0a15\u0a30\u0a3f \u0a17\u0a41\u0a30 \u0a38\u0a24\u0a3f\u0a17\u0a41\u0a30 \u0a2c\u0a1a\u0a28\u0a40 \u0965","\u0a05\u0a28\u0a26\u0a3f\u0a28\u0a41 \u0a38\u0a47\u0a35\u0a40 \u0a17\u0a41\u0a23 \u0a30\u0a35\u0a3e \u0a2e\u0a28\u0a41 \u0a38\u0a1a\u0a48 \u0a30\u0a1a\u0a28\u0a40 \u0965"],translation:"The Merciful Lord Himself forgives those who dwell upon the Word of the Guru, the True Guru.",transliteration:["aape bakhase dhiaa kar gur satigur bachanee ||","anadhin sevee gun ravaa man sachai rachanee ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a38\u0a42\u0a39\u0a40",ang:791,shabadId:2972},{lines:["\u0a10\u0a38\u0a40 \u0a32\u0a3e\u0a32 \u0a24\u0a41\u0a1d \u0a2c\u0a3f\u0a28\u0a41 \u0a15\u0a09\u0a28\u0a41 \u0a15\u0a30\u0a48 \u0965","\u0a17\u0a30\u0a40\u0a2c \u0a28\u0a3f\u0a35\u0a3e\u0a1c\u0a41 \u0a17\u0a41\u0a38\u0a08\u0a06 \u0a2e\u0a47\u0a30\u0a3e \u0a2e\u0a3e\u0a25\u0a48 \u0a1b\u0a24\u0a4d\u0a30\u0a41 \u0a27\u0a30\u0a48 \u0965\u0a67\u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965"],translation:"O Love, who else but You could do such a thing?",transliteration:["aaisee laal tujh bin kaun karai ||","gareeb nivaaj gusieeaa meraa maathai chhatr dharai ||1|| rahaau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a3e\u0a30\u0a42",ang:1106,shabadId:3973},{lines:["\u0a39\u0a30\u0a3f \u0a28\u0a3e\u0a2e\u0a41 \u0a30\u0a3f\u0a26\u0a48 \u0a2a\u0a30\u0a4b\u0a07\u0a06 \u0965","\u0a38\u0a2d\u0a41 \u0a15\u0a3e\u0a1c\u0a41 \u0a39\u0a2e\u0a3e\u0a30\u0a3e \u0a39\u0a4b\u0a07\u0a06 \u0965"],translation:"I have woven the Lord's Name into the fabric of my heart.",transliteration:["har naam ridhai paroiaa ||","sabh kaaj hamaaraa hoiaa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a38\u0a4b\u0a30\u0a20\u0a3f",ang:627,shabadId:2371},{lines:["\u0a1b\u0a4b\u0a21\u0a3f \u0a1b\u0a4b\u0a21\u0a3f \u0a30\u0a47 \u0a2c\u0a3f\u0a16\u0a3f\u0a06 \u0a15\u0a47 \u0a30\u0a38\u0a42\u0a06 \u0965","\u0a09\u0a30\u0a1d\u0a3f \u0a30\u0a39\u0a3f\u0a13 \u0a30\u0a47 \u0a2c\u0a3e\u0a35\u0a30 \u0a17\u0a3e\u0a35\u0a30 \u0a1c\u0a3f\u0a09 \u0a15\u0a3f\u0a30\u0a16\u0a48 \u0a39\u0a30\u0a3f\u0a06\u0a07\u0a13 \u0a2a\u0a38\u0a42\u0a06 \u0965\u0a67\u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965"],translation:"Give them up - give up the pleasures of corruption;",transliteration:["chhodd chhodd re bikhiaa ke rasooaa ||","aurajh rahio re baavar gaavar jiau kirakhai hariaaio pasooaa ||1|| rahaau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:206,shabadId:647},{lines:["\u0a24\u0a3f\u0a38\u0a41 \u0a24\u0a42 \u0a38\u0a47\u0a35\u0a3f \u0a1c\u0a3f\u0a28\u0a3f \u0a24\u0a42 \u0a15\u0a40\u0a06 \u0965","\u0a24\u0a3f\u0a38\u0a41 \u0a05\u0a30\u0a3e\u0a27\u0a3f \u0a1c\u0a3f\u0a28\u0a3f \u0a1c\u0a40\u0a09 \u0a26\u0a40\u0a06 \u0965"],translation:"Serve the One who created You.",transliteration:["tis too sev jin too keeaa ||","tis araadh jin jeeau dheeaa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a38\u0a70\u0a24",ang:1182,shabadId:4204},{lines:["\u0a24\u0a42\u0a70 \u0a06\u0a2a\u0a47 \u0a39\u0a40 \u0a38\u0a3f\u0a27 \u0a38\u0a3e\u0a27\u0a3f\u0a15\u0a4b \u0a24\u0a42 \u0a06\u0a2a\u0a47 \u0a39\u0a40 \u0a1c\u0a41\u0a17 \u0a1c\u0a4b\u0a17\u0a40\u0a06 \u0965","\u0a24\u0a42 \u0a06\u0a2a\u0a47 \u0a39\u0a40 \u0a30\u0a38 \u0a30\u0a38\u0a40\u0a05\u0a5c\u0a3e \u0a24\u0a42 \u0a06\u0a2a\u0a47 \u0a39\u0a40 \u0a2d\u0a4b\u0a17 \u0a2d\u0a4b\u0a17\u0a40\u0a06 \u0965"],translation:"You Yourself are the Siddha and the seeker; You Yourself are the Yoga and the Yogi.",transliteration:["too(n) aape hee sidh saadhiko too aape hee jug jogeeaa ||","too aape hee ras raseeaRaa too aape hee bhog bhogeeaa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a15\u0a3e\u0a28\u0a5c\u0a3e",ang:1313,shabadId:4766},{lines:["\u0a05\u0a2a\u0a28\u0a40 \u0a09\u0a15\u0a24\u0a3f \u0a16\u0a32\u0a3e\u0a35\u0a48 \u0a2d\u0a4b\u0a1c\u0a28 \u0a05\u0a2a\u0a28\u0a40 \u0a09\u0a15\u0a24\u0a3f \u0a16\u0a47\u0a32\u0a3e\u0a35\u0a48 \u0965","\u0a38\u0a30\u0a2c \u0a38\u0a42\u0a16 \u0a2d\u0a4b\u0a17 \u0a30\u0a38 \u0a26\u0a47\u0a35\u0a48 \u0a2e\u0a28 \u0a39\u0a40 \u0a28\u0a3e\u0a32\u0a3f \u0a38\u0a2e\u0a3e\u0a35\u0a48 \u0965\u0a67\u0965"],translation:"In His own way, He provides us with our food; in His own way, He plays with us.",transliteration:["apanee ukat khalaavai bhojan apanee ukat khelaavai ||","sarab sookh bhog ras dhevai man hee naal samaavai ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a27\u0a28\u0a3e\u0a38\u0a30\u0a40",ang:680,shabadId:2594},{lines:["\u0a18\u0a28\u0a3f\u0a39\u0a30 \u0a2c\u0a30\u0a38\u0a3f \u0a38\u0a17\u0a32 \u0a1c\u0a17\u0a41 \u0a1b\u0a3e\u0a07\u0a06 \u0965","\u0a2d\u0a0f \u0a15\u0a4d\u0a30\u0a3f\u0a2a\u0a3e\u0a32 \u0a2a\u0a4d\u0a30\u0a40\u0a24\u0a2e \u0a2a\u0a4d\u0a30\u0a2d \u0a2e\u0a47\u0a30\u0a47 \u0a05\u0a28\u0a26 \u0a2e\u0a70\u0a17\u0a32 \u0a38\u0a41\u0a16 \u0a2a\u0a3e\u0a07\u0a06 \u0965\u0a67\u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965"],translation:"The clouds have rained down all over the world.",transliteration:["ghanihar baras sagal jag chhaiaa ||","bhe kirapaal preetam prabh mere anadh ma(n)gal sukh paiaa ||1|| rahaau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a32\u0a3e\u0a30",ang:1268,shabadId:4575},{lines:["\u0a38\u0a3e\u0a38\u0a24\u0a41 \u0a2c\u0a47\u0a26\u0a41 \u0a38\u0a3f\u0a70\u0a2e\u0a4d\u0a30\u0a3f\u0a24\u0a3f \u0a38\u0a30\u0a41 \u0a24\u0a47\u0a30\u0a3e \u0a38\u0a41\u0a30\u0a38\u0a30\u0a40 \u0a1a\u0a30\u0a23 \u0a38\u0a2e\u0a3e\u0a23\u0a40 \u0965","\u0a38\u0a3e\u0a16\u0a3e \u0a24\u0a40\u0a28\u0a3f \u0a2e\u0a42\u0a32\u0a41 \u0a2e\u0a24\u0a3f \u0a30\u0a3e\u0a35\u0a48 \u0a24\u0a42\u0a70 \u0a24\u0a3e\u0a02 \u0a38\u0a30\u0a2c \u0a35\u0a3f\u0a21\u0a3e\u0a23\u0a40 \u0965\u0a67\u0965"],translation:"The Shaastras, the Vedas and the Simritees are contained in the ocean of Your Name; the River Ganges is held in Your Feet.",transliteration:["saasat bedh si(n)mirat sar teraa surasaree charan samaanee ||","saakhaa teen mool mat raavai too(n) taa(n) sarab viddaanee ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a06\u0a38\u0a3e",ang:422,shabadId:1621},{lines:["\u0a27\u0a28\u0a41 \u0a38\u0a41 \u0a35\u0a47\u0a32\u0a3e \u0a1c\u0a3f\u0a24\u0a41 \u0a26\u0a30\u0a38\u0a28\u0a41 \u0a15\u0a30\u0a23\u0a3e \u0965","\u0a39\u0a09 \u0a2c\u0a32\u0a3f\u0a39\u0a3e\u0a30\u0a40 \u0a38\u0a24\u0a3f\u0a17\u0a41\u0a30 \u0a1a\u0a30\u0a23\u0a3e \u0965\u0a67\u0965"],translation:"Blessed is that time, when the Blessed Vision of His Darshan is given;",transliteration:["dhanu su velaa jit dharasan karanaa ||","hau balihaaree satigur charanaa ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a35\u0a21\u0a39\u0a70\u0a38\u0a41",ang:562,shabadId:2160},{lines:["\u0a39\u0a30\u0a3f \u0a1c\u0a40\u0a09 \u0a38\u0a47\u0a35\u0a3f\u0a39\u0a41 \u0a05\u0a17\u0a2e \u0a05\u0a2a\u0a3e\u0a30\u0a3e \u0965","\u0a24\u0a3f\u0a38 \u0a26\u0a3e \u0a05\u0a70\u0a24\u0a41 \u0a28 \u0a2a\u0a3e\u0a08\u0a10 \u0a2a\u0a3e\u0a30\u0a3e\u0a35\u0a3e\u0a30\u0a3e \u0965"],translation:"Serve the Dear Lord, the inaccessible and infinite.",transliteration:["har jeeau sevih agam apaaraa ||","tis dhaa a(n)t na paieeaai paaraavaaraa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a3e\u0a30\u0a42",ang:1055,shabadId:3769},{lines:["\u0a18\u0a5c\u0a40\u0a06 \u0a38\u0a2d\u0a47 \u0a17\u0a4b\u0a2a\u0a40\u0a06 \u0a2a\u0a39\u0a30 \u0a15\u0a70\u0a28\u0a51 \u0a17\u0a4b\u0a2a\u0a3e\u0a32 \u0965","\u0a17\u0a39\u0a23\u0a47 \u0a2a\u0a09\u0a23\u0a41 \u0a2a\u0a3e\u0a23\u0a40 \u0a2c\u0a48\u0a38\u0a70\u0a24\u0a30\u0a41 \u0a1a\u0a70\u0a26\u0a41 \u0a38\u0a42\u0a30\u0a1c\u0a41 \u0a05\u0a35\u0a24\u0a3e\u0a30 \u0965"],translation:"All the hours are the milk-maids, and the quarters of the day are the Krishnas.",transliteration:["ghaReeaa sabhe gopeeaa pahar ka(n)n(h) gopaal ||","gahane paun paanee baisa(n)tar cha(n)dh sooraj avataar ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a06\u0a38\u0a3e",ang:465,shabadId:1699},{lines:["\u0a2c\u0a27\u0a3e \u0a1a\u0a1f\u0a40 \u0a1c\u0a4b \u0a2d\u0a30\u0a47 \u0a28\u0a3e \u0a17\u0a41\u0a23\u0a41 \u0a28\u0a3e \u0a09\u0a2a\u0a15\u0a3e\u0a30\u0a41 \u0965","\u0a38\u0a47\u0a24\u0a40 \u0a16\u0a41\u0a38\u0a40 \u0a38\u0a35\u0a3e\u0a30\u0a40\u0a10 \u0a28\u0a3e\u0a28\u0a15 \u0a15\u0a3e\u0a30\u0a1c\u0a41 \u0a38\u0a3e\u0a30\u0a41 \u0965\u0a69\u0965"],translation:"Paying a fine under pressure, does not bring either merit or goodness.",transliteration:["badhaa chaTee jo bhare naa gun naa upakaar ||","setee khusee savaareeaai naanak kaaraj saar ||3||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a38\u0a42\u0a39\u0a40",ang:787,shabadId:2934},{lines:["\u0a30\u0a3e\u0a2e \u0a28\u0a3e\u0a2e\u0a41 \u0a30\u0a24\u0a28 \u0a15\u0a4b\u0a20\u0a5c\u0a40 \u0a17\u0a5c \u0a2e\u0a70\u0a26\u0a30\u0a3f \u0a0f\u0a15 \u0a32\u0a41\u0a15\u0a3e\u0a28\u0a40 \u0965","\u0a38\u0a24\u0a3f\u0a17\u0a41\u0a30\u0a41 \u0a2e\u0a3f\u0a32\u0a48 \u0a24 \u0a16\u0a4b\u0a1c\u0a40\u0a10 \u0a2e\u0a3f\u0a32\u0a3f \u0a1c\u0a4b\u0a24\u0a40 \u0a1c\u0a4b\u0a24\u0a3f \u0a38\u0a2e\u0a3e\u0a28\u0a40 \u0965\u0a67\u0965"],translation:"The Lord's Name is a jewel, hidden in a chamber of the palace of the body-fortress.",transliteration:["raam naam ratan koThaRee gaR ma(n)dhar ek lukaanee ||","satigur milai ta khojeeaai mil jotee jot samaanee ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a38\u0a70\u0a24",ang:1178,shabadId:4191},{lines:["\u0a1c\u0a24 \u0a15\u0a24\u0a39 \u0a24\u0a24\u0a39 \u0a26\u0a4d\u0a30\u0a3f\u0a38\u0a1f\u0a70 \u0a38\u0a4d\u0a35\u0a30\u0a17 \u0a2e\u0a30\u0a24 \u0a2a\u0a2f\u0a3e\u0a32 \u0a32\u0a4b\u0a15\u0a39 \u0965","\u0a38\u0a30\u0a2c\u0a24\u0a4d\u0a30 \u0a30\u0a2e\u0a23\u0a70 \u0a17\u0a4b\u0a2c\u0a3f\u0a70\u0a26\u0a39 \u0a28\u0a3e\u0a28\u0a15 \u0a32\u0a47\u0a2a \u0a1b\u0a47\u0a2a \u0a28 \u0a32\u0a3f\u0a2a\u0a75\u0a24\u0a47 \u0965\u0a69\u0a6c\u0965"],translation:"Wherever I look, I see the Lord, whether in this world, in paradise, or the nether regions of the underworld.",transliteration:["jat kateh tateh dhirasaTa(n) savairag marat payaal lokeh ||","sarabatr ramana(n) gobi(n)dheh naanak lep chhep na lipayete ||36||"],raag:"\u0a38\u0a32\u0a4b\u0a15 \u0a38\u0a39\u0a38\u0a15\u0a4d\u0a30\u0a3f\u0a24\u0a40",ang:1357,shabadId:4935},{lines:["\u0a1c\u0a4b \u0a39\u0a30\u0a3f \u0a38\u0a47\u0a35\u0a39\u0a3f \u0a24\u0a3f\u0a28 \u0a2c\u0a32\u0a3f \u0a1c\u0a3e\u0a09 \u0965","\u0a24\u0a3f\u0a28 \u0a39\u0a3f\u0a30\u0a26\u0a48 \u0a38\u0a3e\u0a1a\u0a41 \u0a38\u0a1a\u0a3e \u0a2e\u0a41\u0a16\u0a3f \u0a28\u0a3e\u0a09 \u0965"],translation:"I am a sacrifice to those who serve the Lord.",transliteration:["jo har seveh tin bal jaau ||","tin hiradhai saach sachaa mukh naau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a27\u0a28\u0a3e\u0a38\u0a30\u0a40",ang:665,shabadId:2538},{lines:["\u0a39\u0a30\u0a3f \u0a15\u0a47 \u0a26\u0a30\u0a38\u0a28 \u0a15\u0a4b \u0a2e\u0a28\u0a3f \u0a1a\u0a3e\u0a09 \u0965","\u0a15\u0a30\u0a3f \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a38\u0a24\u0a38\u0a70\u0a17\u0a3f \u0a2e\u0a3f\u0a32\u0a3e\u0a35\u0a39\u0a41 \u0a24\u0a41\u0a2e \u0a26\u0a47\u0a35\u0a39\u0a41 \u0a05\u0a2a\u0a28\u0a4b \u0a28\u0a3e\u0a09 \u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965"],translation:"My mind yearns for the Blessed Vision of the Lord's Darshan.",transliteration:["har ke dharasan ko man chaau ||","kar kirapaa satasa(n)g milaavahu tum dhevahu apano naau || rahaau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a15\u0a47\u0a26\u0a3e\u0a30\u0a3e",ang:1119,shabadId:4007},{lines:["\u0a38\u0a38\u0a3e \u0a38\u0a3f\u0a06\u0a28\u0a2a \u0a1b\u0a3e\u0a21\u0a41 \u0a07\u0a06\u0a28\u0a3e \u0965","\u0a39\u0a3f\u0a15\u0a2e\u0a24\u0a3f \u0a39\u0a41\u0a15\u0a2e\u0a3f \u0a28 \u0a2a\u0a4d\u0a30\u0a2d\u0a41 \u0a2a\u0a24\u0a40\u0a06\u0a28\u0a3e \u0965"],translation:"SASSA: Give up your clever tricks, you ignorant fool!",transliteration:["sasaa siaanap chhaadd iaanaa ||","hikamat hukam na prabh pateeaanaa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:260,shabadId:859},{lines:["\u0a1c\u0a40\u0a09 \u0a21\u0a30\u0a24\u0a41 \u0a39\u0a48 \u0a06\u0a2a\u0a23\u0a3e \u0a15\u0a48 \u0a38\u0a3f\u0a09 \u0a15\u0a30\u0a40 \u0a2a\u0a41\u0a15\u0a3e\u0a30 \u0965","\u0a26\u0a42\u0a16 \u0a35\u0a3f\u0a38\u0a3e\u0a30\u0a23\u0a41 \u0a38\u0a47\u0a35\u0a3f\u0a06 \u0a38\u0a26\u0a3e \u0a38\u0a26\u0a3e \u0a26\u0a3e\u0a24\u0a3e\u0a30\u0a41 \u0965\u0a67\u0965"],translation:"My soul is afraid; to whom should I complain?",transliteration:["jeeau ddarat hai aapanaa kai siau karee pukaar ||","dhookh visaaran seviaa sadhaa sadhaa dhaataar ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a27\u0a28\u0a3e\u0a38\u0a30\u0a40",ang:660,shabadId:2525},{lines:["\u0a17\u0a41\u0a30\u0a41 \u0a2a\u0a42\u0a30\u0a3e \u0a35\u0a21\u0a2d\u0a3e\u0a17\u0a40 \u0a2a\u0a3e\u0a08\u0a10 \u0965","\u0a2e\u0a3f\u0a32\u0a3f \u0a38\u0a3e\u0a27\u0a42 \u0a39\u0a30\u0a3f \u0a28\u0a3e\u0a2e\u0a41 \u0a27\u0a3f\u0a06\u0a08\u0a10 \u0965\u0a67\u0965"],translation:"By great good fortune, the Perfect Guru is found.",transliteration:["gur pooraa vaddabhaagee paieeaai ||","mil saadhoo har naam dhiaaieeaai ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a3f\u0a32\u0a3e\u0a35\u0a32",ang:804,shabadId:3017},{lines:["\u0a38\u0a4b \u0a1c\u0a2a\u0a41 \u0a38\u0a4b \u0a24\u0a2a\u0a41 \u0a1c\u0a3f \u0a38\u0a24\u0a3f\u0a17\u0a41\u0a30 \u0a2d\u0a3e\u0a35\u0a48 \u0965","\u0a38\u0a24\u0a3f\u0a17\u0a41\u0a30 \u0a15\u0a48 \u0a2d\u0a3e\u0a23\u0a48 \u0a35\u0a21\u0a3f\u0a06\u0a08 \u0a2a\u0a3e\u0a35\u0a48 \u0965"],translation:"That alone is chanting, and that alone is deep meditation, which is pleasing to the True Guru.",transliteration:["so jap so tap j satigur bhaavai ||","satigur kai bhaanai vaddiaaiee paavai ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a42\u0a1c\u0a30\u0a40",ang:509,shabadId:1883},{lines:["\u0a39\u0a30\u0a3f \u0a39\u0a30\u0a3f \u0a28\u0a3e\u0a2e\u0a41 \u0a2a\u0a35\u0a3f\u0a24\u0a41 \u0a39\u0a48 \u0a28\u0a3e\u0a2e\u0a41 \u0a1c\u0a2a\u0a24 \u0a26\u0a41\u0a16\u0a41 \u0a1c\u0a3e\u0a07 \u0965","\u0a1c\u0a3f\u0a28 \u0a15\u0a09 \u0a2a\u0a42\u0a30\u0a2c\u0a3f \u0a32\u0a3f\u0a16\u0a3f\u0a06 \u0a24\u0a3f\u0a28 \u0a2e\u0a28\u0a3f \u0a35\u0a38\u0a3f\u0a06 \u0a06\u0a07 \u0965"],translation:"The Name of the Lord, Har, Har, is Sacred and Immaculate. Chanting the Naam, pain is dispelled.",transliteration:["har har naam pavit hai naam japat dhukh jai ||","jin kau poorab likhiaa tin man vasiaa aai ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a15\u0a3e\u0a28\u0a5c\u0a3e",ang:1313,shabadId:4771},{lines:["\u0a35\u0a48\u0a26\u0a41 \u0a2c\u0a41\u0a32\u0a3e\u0a07\u0a06 \u0a35\u0a48\u0a26\u0a17\u0a40 \u0a2a\u0a15\u0a5c\u0a3f \u0a22\u0a70\u0a22\u0a4b\u0a32\u0a47 \u0a2c\u0a3e\u0a02\u0a39 \u0965","\u0a2d\u0a4b\u0a32\u0a3e \u0a35\u0a48\u0a26\u0a41 \u0a28 \u0a1c\u0a3e\u0a23\u0a08 \u0a15\u0a30\u0a15 \u0a15\u0a32\u0a47\u0a1c\u0a47 \u0a2e\u0a3e\u0a39\u0a3f \u0965\u0a67\u0965"],translation:"The physician was called in; he touched my arm and felt my pulse.",transliteration:["vaidh bulaiaa vaidhagee pakaR dda(n)ddole baa(n)h ||","bholaa vaidh na jaaniee karak kaleje maeh ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a32\u0a3e\u0a30",ang:1279,shabadId:4609},{lines:["\u0a15\u0a2c\u0a40\u0a30 \u0a39\u0a30\u0a3f \u0a15\u0a3e \u0a38\u0a3f\u0a2e\u0a30\u0a28\u0a41 \u0a1b\u0a3e\u0a21\u0a3f \u0a15\u0a48 \u0a2a\u0a3e\u0a32\u0a3f\u0a13 \u0a2c\u0a39\u0a41\u0a24\u0a41 \u0a15\u0a41\u0a1f\u0a70\u0a2c\u0a41 \u0965","\u0a27\u0a70\u0a27\u0a3e \u0a15\u0a30\u0a24\u0a3e \u0a30\u0a39\u0a3f \u0a17\u0a07\u0a06 \u0a2d\u0a3e\u0a08 \u0a30\u0a39\u0a3f\u0a06 \u0a28 \u0a2c\u0a70\u0a27\u0a41 \u0965\u0a67\u0a66\u0a6c\u0965"],translation:"Kabeer, you have given up meditating on the Lord, and you have raised a large family.",transliteration:["kabeer har kaa simaran chhaadd kai paalio bahut kuTa(n)b ||","dha(n)dhaa karataa reh giaa bhaiee rahiaa na ba(n)dh ||106||"],raag:"\u0a38\u0a32\u0a4b\u0a15 \u0a2d\u0a17\u0a24 \u0a15\u0a2c\u0a40\u0a30 \u0a1c\u0a40\u0a09 \u0a15\u0a47",ang:1370,shabadId:5074},{lines:["\u0a15\u0a2c\u0a40\u0a30 \u0a1a\u0a4b\u0a1f \u0a38\u0a41\u0a39\u0a47\u0a32\u0a40 \u0a38\u0a47\u0a32 \u0a15\u0a40 \u0a32\u0a3e\u0a17\u0a24 \u0a32\u0a47\u0a07 \u0a09\u0a38\u0a3e\u0a38 \u0965","\u0a1a\u0a4b\u0a1f \u0a38\u0a39\u0a3e\u0a30\u0a48 \u0a38\u0a2c\u0a26 \u0a15\u0a40 \u0a24\u0a3e\u0a38\u0a41 \u0a17\u0a41\u0a30\u0a42 \u0a2e\u0a48 \u0a26\u0a3e\u0a38 \u0965\u0a67\u0a6e\u0a69\u0965"],translation:"Kabeer, the stroke of a lance is easy to bear; it takes away the breath.",transliteration:["kabeer choT suhelee sel kee laagat lei usaas ||","choT sahaarai sabadh kee taas guroo mai dhaas ||183||"],raag:"\u0a38\u0a32\u0a4b\u0a15 \u0a2d\u0a17\u0a24 \u0a15\u0a2c\u0a40\u0a30 \u0a1c\u0a40\u0a09 \u0a15\u0a47",ang:1374,shabadId:5151},{lines:["\u0a2a\u0a4d\u0a30\u0a25\u0a2e\u0a47 \u0a1b\u0a4b\u0a21\u0a40 \u0a2a\u0a30\u0a3e\u0a08 \u0a28\u0a3f\u0a70\u0a26\u0a3e \u0965","\u0a09\u0a24\u0a30\u0a3f \u0a17\u0a08 \u0a38\u0a2d \u0a2e\u0a28 \u0a15\u0a40 \u0a1a\u0a3f\u0a70\u0a26\u0a3e \u0965"],translation:"First, I gave up slandering others.",transliteration:["prathame chhoddee paraiee ni(n)dhaa ||","autar giee sabh man kee chi(n)dhaa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41  \u0a2d\u0a48\u0a30\u0a73",ang:1147,shabadId:4102},{lines:["\u0a2a\u0a3e\u0a28\u0a40 \u0a2e\u0a48\u0a32\u0a3e \u0a2e\u0a3e\u0a1f\u0a40 \u0a17\u0a4b\u0a30\u0a40 \u0965","\u0a07\u0a38 \u0a2e\u0a3e\u0a1f\u0a40 \u0a15\u0a40 \u0a2a\u0a41\u0a24\u0a30\u0a40 \u0a1c\u0a4b\u0a30\u0a40 \u0965\u0a67\u0965"],translation:"The water of the sperm is cloudy, and the egg of the ovary is crimson.",transliteration:["paanee mailaa maaTee goree ||","eis maaTee kee putaree joree ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:336,shabadId:1344},{lines:["\u0a28\u0a3e\u0a09 \u0a2b\u0a15\u0a40\u0a30\u0a48 \u0a2a\u0a3e\u0a24\u0a3f\u0a38\u0a3e\u0a39\u0a41 \u0a2e\u0a42\u0a30\u0a16 \u0a2a\u0a70\u0a21\u0a3f\u0a24\u0a41 \u0a28\u0a3e\u0a09 \u0965","\u0a05\u0a70\u0a27\u0a47 \u0a15\u0a3e \u0a28\u0a3e\u0a09 \u0a2a\u0a3e\u0a30\u0a16\u0a42 \u0a0f\u0a35\u0a48 \u0a15\u0a30\u0a47 \u0a17\u0a41\u0a06\u0a09 \u0965"],translation:"The beggar is known as an emperor, and the fool is known as a religious scholar.",transliteration:["naau fakeerai paatisaahu moorakh pa(n)ddit naau ||","a(n)dhe kaa naau paarakhoo evai kare guaau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a32\u0a3e\u0a30",ang:1288,shabadId:4668},{lines:["\u0a2b\u0a30\u0a40\u0a26\u0a3e \u0a17\u0a32\u0a02\u0a40 \u0a38\u0a41 \u0a38\u0a1c\u0a23 \u0a35\u0a40\u0a39 \u0a07\u0a15\u0a41 \u0a22\u0a42\u0a70\u0a22\u0a47\u0a26\u0a40 \u0a28 \u0a32\u0a39\u0a3e\u0a02 \u0965","\u0a27\u0a41\u0a16\u0a3e\u0a02 \u0a1c\u0a3f\u0a09 \u0a2e\u0a3e\u0a02\u0a32\u0a40\u0a39 \u0a15\u0a3e\u0a30\u0a23\u0a3f \u0a24\u0a3f\u0a70\u0a28\u0a51\u0a3e \u0a2e\u0a3e \u0a2a\u0a3f\u0a30\u0a40 \u0965\u0a6e\u0a6d\u0965"],translation:"Fareed, there are dozens who say they are friends; I search, but I cannot find even one.",transliteration:["fareedhaa gala(n)ee su sajan veeh ik ddoo(n)ddedhee na lahaa(n) ||","dhukhaa(n) jiau maa(n)leeh kaaran ti(n)n(h)aa maa piree ||87||"],raag:"\u0a38\u0a32\u0a4b\u0a15 \u0a38\u0a47\u0a16 \u0a2b\u0a30\u0a40\u0a26 \u0a15",ang:1382,shabadId:5295},{lines:["\u0a1c\u0a47 \u0a13\u0a39\u0a41 \u0a05\u0a20\u0a38\u0a20\u0a3f \u0a24\u0a40\u0a30\u0a25 \u0a28\u0a51\u0a3e\u0a35\u0a48 \u0965","\u0a1c\u0a47 \u0a13\u0a39\u0a41 \u0a26\u0a41\u0a06\u0a26\u0a38 \u0a38\u0a3f\u0a32\u0a3e \u0a2a\u0a42\u0a1c\u0a3e\u0a35\u0a48 \u0965"],translation:"Someone may bathe at the sixty-eight sacred shrines of pilgrimage,",transliteration:["je oh aThasaTh teerath n(h)aavai ||","je oh dhuaadhas silaa poojaavai ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a4b\u0a02\u0a21",ang:875,shabadId:3270},{lines:["\u0a17\u0a41\u0a30 \u0a2a\u0a42\u0a30\u0a47 \u0a15\u0a40 \u0a26\u0a3e\u0a24\u0a3f \u0a28\u0a3f\u0a24 \u0a26\u0a47\u0a35\u0a48 \u0a1a\u0a5c\u0a48 \u0a38\u0a35\u0a3e\u0a08\u0a06 \u0965","\u0a24\u0a41\u0a38\u0a3f \u0a26\u0a47\u0a35\u0a48 \u0a06\u0a2a\u0a3f \u0a26\u0a07\u0a06\u0a32\u0a41 \u0a28 \u0a1b\u0a2a\u0a48 \u0a1b\u0a2a\u0a3e\u0a08\u0a06 \u0965"],translation:"The Perfect Guru bestows His gifts, which increase day by day.",transliteration:["gur poore kee dhaat nit dhevai chaRai savaieeaa ||","tus dhevai aap dhiaal na chhapai chhapaieeaa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a38\u0a3e\u0a30\u0a70\u0a17",ang:1250,shabadId:4519},{lines:["\u0a1c\u0a4b \u0a1c\u0a3e\u0a28\u0a48 \u0a24\u0a3f\u0a38\u0a41 \u0a38\u0a26\u0a3e \u0a38\u0a41\u0a16\u0a41 \u0a39\u0a4b\u0a07 \u0965","\u0a06\u0a2a\u0a3f \u0a2e\u0a3f\u0a32\u0a3e\u0a07 \u0a32\u0a0f \u0a2a\u0a4d\u0a30\u0a2d\u0a41 \u0a38\u0a4b\u0a07 \u0965"],translation:"One who knows Him, obtains everlasting peace.",transliteration:["jo jaanai tis sadhaa sukh hoi ||","aap milai le prabh soi ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:294,shabadId:1077},{lines:["\u0a2c\u0a3e\u0a2c\u0a3e \u0a06\u0a07\u0a06 \u0a39\u0a48 \u0a09\u0a20\u0a3f \u0a1a\u0a32\u0a23\u0a3e \u0a07\u0a39\u0a41 \u0a1c\u0a17\u0a41 \u0a1d\u0a42\u0a20\u0a41 \u0a2a\u0a38\u0a3e\u0a30\u0a4b\u0a35\u0a3e \u0965","\u0a38\u0a1a\u0a3e \u0a18\u0a30\u0a41 \u0a38\u0a1a\u0a5c\u0a48 \u0a38\u0a47\u0a35\u0a40\u0a10 \u0a38\u0a1a\u0a41 \u0a16\u0a30\u0a3e \u0a38\u0a1a\u0a3f\u0a06\u0a30\u0a4b\u0a35\u0a3e \u0965"],translation:"O Baba, whoever has come, will rise up and leave; this world is merely a false show.",transliteration:["baabaa aaiaa hai uTh chalanaa ih jag jhooTh pasaarovaa ||","sachaa ghar sachaRai seveeaai sach kharaa sachiaarovaa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a35\u0a21\u0a39\u0a70\u0a38\u0a41",ang:581,shabadId:2198},{lines:["\u0a1a\u0a09\u0a26\u0a39\u0a3f \u0a1a\u0a3e\u0a30\u0a3f \u0a15\u0a41\u0a70\u0a1f \u0a2a\u0a4d\u0a30\u0a2d \u0a06\u0a2a \u0965","\u0a38\u0a17\u0a32 \u0a2d\u0a35\u0a28 \u0a2a\u0a42\u0a30\u0a28 \u0a2a\u0a30\u0a24\u0a3e\u0a2a \u0965"],translation:"The fourteenth day of the lunar cycle: God Himself is in all four directions.",transliteration:["chaudheh chaar ku(n)T prabh aap ||","sagal bhavan pooran parataap ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:299,shabadId:1114},{lines:["\u0a1c\u0a40\u0a35\u0a3e \u0a24\u0a47\u0a30\u0a48 \u0a28\u0a3e\u0a07 \u0a2e\u0a28\u0a3f \u0a06\u0a28\u0a70\u0a26\u0a41 \u0a39\u0a48 \u0a1c\u0a40\u0a09 \u0965","\u0a38\u0a3e\u0a1a\u0a4b \u0a38\u0a3e\u0a1a\u0a3e \u0a28\u0a3e\u0a09 \u0a17\u0a41\u0a23 \u0a17\u0a4b\u0a35\u0a3f\u0a70\u0a26\u0a41 \u0a39\u0a48 \u0a1c\u0a40\u0a09 \u0965"],translation:"I live by Your Name; my mind is in ecstasy, Lord.",transliteration:["jeevaa terai nai man aana(n)dh hai jeeau ||","saacho saachaa naau gun govi(n)dh hai jeeau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a27\u0a28\u0a3e\u0a38\u0a30\u0a40",ang:688,shabadId:2622},{lines:["\u0a2d\u0a2d\u0a3e \u0a2d\u0a30\u0a2e\u0a41 \u0a2e\u0a3f\u0a1f\u0a3e\u0a35\u0a39\u0a41 \u0a05\u0a2a\u0a28\u0a3e \u0965","\u0a07\u0a06 \u0a38\u0a70\u0a38\u0a3e\u0a30\u0a41 \u0a38\u0a17\u0a32 \u0a39\u0a48 \u0a38\u0a41\u0a2a\u0a28\u0a3e \u0965"],translation:"BHABHA: Cast out your doubt and delusion",transliteration:["bhabhaa bharam miTaavahu apanaa ||","eiaa sa(n)saar sagal hai supanaa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:258,shabadId:839},{lines:["\u0a2e\u0a3f\u0a39\u0a30 \u0a2e\u0a38\u0a40\u0a24\u0a3f \u0a38\u0a3f\u0a26\u0a15\u0a41 \u0a2e\u0a41\u0a38\u0a32\u0a3e \u0a39\u0a15\u0a41 \u0a39\u0a32\u0a3e\u0a32\u0a41 \u0a15\u0a41\u0a30\u0a3e\u0a23\u0a41 \u0965","\u0a38\u0a30\u0a2e \u0a38\u0a41\u0a70\u0a28\u0a24\u0a3f \u0a38\u0a40\u0a32\u0a41 \u0a30\u0a4b\u0a1c\u0a3e \u0a39\u0a4b\u0a39\u0a41 \u0a2e\u0a41\u0a38\u0a32\u0a2e\u0a3e\u0a23\u0a41 \u0965"],translation:"Let mercy be your mosque, faith your prayer-mat, and honest living your Koran.",transliteration:["mihar maseet sidhak musalaa hak halaal kuraan ||","saram su(n)nat seel rojaa hoh musalamaan ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a3e\u0a1d",ang:140,shabadId:379},{lines:["\u0a2a\u0a4d\u0a30\u0a2d \u0a1c\u0a40 \u0a24\u0a42 \u0a2e\u0a47\u0a30\u0a47 \u0a2a\u0a4d\u0a30\u0a3e\u0a28 \u0a05\u0a27\u0a3e\u0a30\u0a48 \u0965","\u0a28\u0a2e\u0a38\u0a15\u0a3e\u0a30 \u0a21\u0a70\u0a21\u0a09\u0a24\u0a3f \u0a2c\u0a70\u0a26\u0a28\u0a3e \u0a05\u0a28\u0a3f\u0a15 \u0a2c\u0a3e\u0a30 \u0a1c\u0a3e\u0a09 \u0a2c\u0a3e\u0a30\u0a48 \u0965\u0a67\u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965"],translation:"O Dear God, You are the Support of my breath of life.",transliteration:["prabh jee too mere praan adhaarai ||","namasakaar dda(n)ddaut ba(n)dhanaa anik baar jaau baarai ||1|| rahaau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a3f\u0a32\u0a3e\u0a35\u0a32",ang:820,shabadId:3088},{lines:["\u0a1c\u0a3f\u0a28 \u0a21\u0a3f\u0a20\u0a3f\u0a06 \u0a2e\u0a28\u0a41 \u0a30\u0a39\u0a38\u0a40\u0a10 \u0a15\u0a3f\u0a09 \u0a2a\u0a3e\u0a08\u0a10 \u0a24\u0a3f\u0a28\u0a51 \u0a38\u0a70\u0a17\u0a41 \u0a1c\u0a40\u0a09 \u0965","\u0a38\u0a70\u0a24 \u0a38\u0a1c\u0a28 \u0a2e\u0a28 \u0a2e\u0a3f\u0a24\u0a4d\u0a30 \u0a38\u0a47 \u0a32\u0a3e\u0a07\u0a28\u0a3f \u0a2a\u0a4d\u0a30\u0a2d \u0a38\u0a3f\u0a09 \u0a30\u0a70\u0a17\u0a41 \u0a1c\u0a40\u0a09 \u0965"],translation:"Gazing upon them, my mind is enraptured. How can I join them and be with them?",transliteration:["jin ddiThiaa man rahaseeaai kiau paieeaai tin(h) sa(n)g jeeau ||","sa(n)t sajan man mitr se lain prabh siau ra(n)g jeeau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a38\u0a42\u0a39\u0a40",ang:760,shabadId:2878},{lines:["\u0a74 \u0a38\u0a24\u0a3f \u0a28\u0a3e\u0a2e\u0a41 \u0a15\u0a30\u0a24\u0a3e \u0a2a\u0a41\u0a30\u0a16\u0a41 \u0a28\u0a3f\u0a30\u0a2d\u0a09 \u0a28\u0a3f\u0a30\u0a35\u0a48\u0a30\u0a41 \u0a05\u0a15\u0a3e\u0a32 \u0a2e\u0a42\u0a30\u0a24\u0a3f \u0a05\u0a1c\u0a42\u0a28\u0a40 \u0a38\u0a48\u0a2d\u0a70 \u0a17\u0a41\u0a30 \u0a2a\u0a4d\u0a30\u0a38\u0a3e\u0a26\u0a3f \u0965","\u0a06\u0a26\u0a3f \u0a38\u0a1a\u0a41 \u0a1c\u0a41\u0a17\u0a3e\u0a26\u0a3f \u0a38\u0a1a\u0a41 \u0965"],translation:"One Universal Creator God. The Name Is Truth. Creative Being Personified. No Fear. No Hatred. Image Of The Undying, Beyond Birth, Self-Existent. By Guru's Grace ~",transliteration:["ikOankaar sat naam karataa purakh nirabhau niravair akaal moorat ajoonee saibha(n) gur prasaadh ||","aadh sach jugaadh sach ||"],raag:"\u0a1c\u0a2a",ang:1,shabadId:1},{lines:["\u0a35\u0a3e\u0a0a \u0a38\u0a70\u0a26\u0a47 \u0a15\u0a2a\u0a5c\u0a47 \u0a2a\u0a39\u0a3f\u0a30\u0a39\u0a3f \u0a17\u0a30\u0a2c\u0a3f \u0a17\u0a35\u0a3e\u0a30 \u0965","\u0a28\u0a3e\u0a28\u0a15 \u0a28\u0a3e\u0a32\u0a3f \u0a28 \u0a1a\u0a32\u0a28\u0a40 \u0a1c\u0a32\u0a3f \u0a2c\u0a32\u0a3f \u0a39\u0a4b\u0a0f \u0a1b\u0a3e\u0a30\u0a41 \u0965\u0a68\u0965"],translation:"He wears his body, like clothes of wind - what a proud fool he is!",transliteration:["vaauoo sa(n)dhe kapaRe pahireh garab gavaar ||","naanak naal na chalanee jal bal hoe chhaar ||2||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:318,shabadId:1226},{lines:["\u0a39\u0a38\u0a24 \u0a2a\u0a41\u0a28\u0a40\u0a24 \u0a39\u0a4b\u0a39\u0a3f \u0a24\u0a24\u0a15\u0a3e\u0a32 \u0965","\u0a2c\u0a3f\u0a28\u0a38\u0a3f \u0a1c\u0a3e\u0a39\u0a3f \u0a2e\u0a3e\u0a07\u0a06 \u0a1c\u0a70\u0a1c\u0a3e\u0a32 \u0965"],translation:"The hands are sanctified instantly,",transliteration:["hasat puneet hoh tatakaal ||","binas jaeh maiaa ja(n)jaal ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:185,shabadId:548},{lines:["\u0a15\u0a70\u0a1a\u0a28 \u0a15\u0a3e\u0a07\u0a06 \u0a28\u0a3f\u0a30\u0a2e\u0a32\u0a40 \u0a1c\u0a4b \u0a38\u0a1a\u0a3f \u0a28\u0a3e\u0a2e\u0a3f \u0a38\u0a1a\u0a3f \u0a32\u0a3e\u0a17\u0a40 \u0965","\u0a28\u0a3f\u0a30\u0a2e\u0a32 \u0a1c\u0a4b\u0a24\u0a3f \u0a28\u0a3f\u0a30\u0a70\u0a1c\u0a28\u0a41 \u0a2a\u0a3e\u0a07\u0a06 \u0a17\u0a41\u0a30\u0a2e\u0a41\u0a16\u0a3f \u0a2d\u0a4d\u0a30\u0a2e\u0a41 \u0a2d\u0a09 \u0a2d\u0a3e\u0a17\u0a40 \u0965"],translation:"That body is golden and immaculate, which is attached to the True Name of the True Lord.",transliteration:["ka(n)chan kaiaa niramalee jo sach naam sach laagee ||","niramal jot nira(n)jan paiaa gurmukh bhram bhau bhaagee ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a35\u0a21\u0a39\u0a70\u0a38\u0a41",ang:590,shabadId:2238},{lines:["\u0a15\u0a2c\u0a40\u0a30\u0a3e \u0a30\u0a3e\u0a2e\u0a41 \u0a28 \u0a1a\u0a47\u0a24\u0a3f\u0a13 \u0a1c\u0a30\u0a3e \u0a2a\u0a39\u0a42\u0a70\u0a1a\u0a3f\u0a13 \u0a06\u0a07 \u0965","\u0a32\u0a3e\u0a17\u0a40 \u0a2e\u0a70\u0a26\u0a3f\u0a30 \u0a26\u0a41\u0a06\u0a30 \u0a24\u0a47 \u0a05\u0a2c \u0a15\u0a3f\u0a06 \u0a15\u0a3e\u0a22\u0a3f\u0a06 \u0a1c\u0a3e\u0a07 \u0965\u0a67\u0a69\u0a68\u0965"],translation:"Kabeer, you have not contemplated the Lord, and now old age has overtaken you.",transliteration:["kabeeraa raam na chetio jaraa pahoo(n)chio aai ||","laagee ma(n)dhir dhuaar te ab kiaa kaaddiaa jai ||132||"],raag:"\u0a38\u0a32\u0a4b\u0a15 \u0a2d\u0a17\u0a24 \u0a15\u0a2c\u0a40\u0a30 \u0a1c\u0a40\u0a09 \u0a15\u0a47",ang:1371,shabadId:5100},{lines:["\u0a39\u0a30\u0a3f \u0a2c\u0a3f\u0a28\u0a41 \u0a05\u0a35\u0a30 \u0a15\u0a4d\u0a30\u0a3f\u0a06 \u0a2c\u0a3f\u0a30\u0a25\u0a47 \u0965","\u0a1c\u0a2a \u0a24\u0a2a \u0a38\u0a70\u0a1c\u0a2e \u0a15\u0a30\u0a2e \u0a15\u0a2e\u0a3e\u0a23\u0a47 \u0a07\u0a39\u0a3f \u0a13\u0a30\u0a48 \u0a2e\u0a42\u0a38\u0a47 \u0965\u0a67\u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965"],translation:"Without the Lord, other actions are useless.",transliteration:["har bin avar kiraa birathe ||","jap tap sa(n)jam karam kamaane ieh orai moose ||1|| rahaau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:216,shabadId:684},{lines:["\u0a1a\u0a39\u0a41 \u0a1c\u0a41\u0a17\u0a40 \u0a15\u0a32\u0a3f \u0a15\u0a3e\u0a32\u0a40 \u0a15\u0a3e\u0a02\u0a22\u0a40 \u0a07\u0a15 \u0a09\u0a24\u0a2e \u0a2a\u0a26\u0a35\u0a40 \u0a07\u0a38\u0a41 \u0a1c\u0a41\u0a17 \u0a2e\u0a3e\u0a39\u0a3f \u0965","\u0a17\u0a41\u0a30\u0a2e\u0a41\u0a16\u0a3f \u0a39\u0a30\u0a3f \u0a15\u0a40\u0a30\u0a24\u0a3f \u0a2b\u0a32\u0a41 \u0a2a\u0a3e\u0a08\u0a10 \u0a1c\u0a3f\u0a28 \u0a15\u0a09 \u0a39\u0a30\u0a3f \u0a32\u0a3f\u0a16\u0a3f \u0a2a\u0a3e\u0a39\u0a3f \u0965"],translation:"Kali Yuga is called the Dark Age, but the most sublime state is attained in this age.",transliteration:["chahu jugee kal kaalee kaa(n)ddee ik utam padhavee is jug maeh ||","gurmukh har keerat fal paieeaai jin kau har likh paeh ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a38\u0a4b\u0a30\u0a20\u0a3f",ang:651,shabadId:2480},{lines:["\u0a2e\u0a28 \u0a15\u0a30\u0a39\u0a32\u0a3e \u0a35\u0a40\u0a1a\u0a3e\u0a30\u0a40\u0a06 \u0a35\u0a40\u0a1a\u0a3e\u0a30\u0a3f \u0a26\u0a47\u0a16\u0a41 \u0a38\u0a2e\u0a3e\u0a32\u0a3f \u0965","\u0a2c\u0a28 \u0a2b\u0a3f\u0a30\u0a3f \u0a25\u0a15\u0a47 \u0a2c\u0a28 \u0a35\u0a3e\u0a38\u0a40\u0a06 \u0a2a\u0a3f\u0a30\u0a41 \u0a17\u0a41\u0a30\u0a2e\u0a24\u0a3f \u0a30\u0a3f\u0a26\u0a48 \u0a28\u0a3f\u0a39\u0a3e\u0a32\u0a3f \u0965\u0a67\u0965"],translation:"O contemplative camel-like mind, contemplate and look carefully.",transliteration:["man karahalaa veechaareeaa veechaar dhekh samaal ||","ban fir thake ban vaaseeaa pir gurmat ridhai nihaal ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:234,shabadId:730},{lines:["\u0a39\u0a30\u0a3f \u0a39\u0a30\u0a3f \u0a27\u0a3f\u0a06\u0a07 \u0a2e\u0a28\u0a3e \u0a16\u0a3f\u0a28\u0a41 \u0a28 \u0a35\u0a3f\u0a38\u0a3e\u0a30\u0a40\u0a10 \u0965","\u0a30\u0a3e\u0a2e \u0a30\u0a3e\u0a2e\u0a3e \u0a30\u0a3e\u0a2e \u0a30\u0a2e\u0a3e \u0a15\u0a70\u0a20\u0a3f \u0a09\u0a30 \u0a27\u0a3e\u0a30\u0a40\u0a10 \u0965"],translation:"Meditate on the Lord, Har, Har, O mind; don't forget Him, even for an instant.",transliteration:["har har dhiaai manaa khin na visaareeaai ||","raam raamaa raam ramaa ka(n)Th ur dhaareeaai ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a30\u0a3e\u0a2e\u0a15\u0a32\u0a40",ang:925,shabadId:3378},{lines:["\u0a2c\u0a4b\u0a32\u0a39\u0a41 \u0a2d\u0a08\u0a06 \u0a30\u0a3e\u0a2e \u0a28\u0a3e\u0a2e\u0a41 \u0a2a\u0a24\u0a3f\u0a24 \u0a2a\u0a3e\u0a35\u0a28\u0a4b \u0965","\u0a39\u0a30\u0a3f \u0a38\u0a70\u0a24 \u0a2d\u0a17\u0a24 \u0a24\u0a3e\u0a30\u0a28\u0a4b \u0965"],translation:"O Siblings of Destiny, chant the Name of the Lord, the Purifier of sinners.",transliteration:["bolahu bhieeaa raam naam patit paavano ||","har sa(n)t bhagat taarano ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a3f\u0a32\u0a3e\u0a35\u0a32",ang:800,shabadId:3006},{lines:["\u0a28\u0a3e\u0a28\u0a15 \u0a2a\u0a30\u0a16\u0a47 \u0a06\u0a2a \u0a15\u0a09 \u0a24\u0a3e \u0a2a\u0a3e\u0a30\u0a16\u0a41 \u0a1c\u0a3e\u0a23\u0a41 \u0965","\u0a30\u0a4b\u0a17\u0a41 \u0a26\u0a3e\u0a30\u0a42 \u0a26\u0a4b\u0a35\u0a48 \u0a2c\u0a41\u0a1d\u0a48 \u0a24\u0a3e \u0a35\u0a48\u0a26\u0a41 \u0a38\u0a41\u0a1c\u0a3e\u0a23\u0a41 \u0965"],translation:"O Nanak, if someone judges himself, only then is he known as a real judge.",transliteration:["naanak parakhe aap kau taa paarakh jaan ||","rog dhaaroo dhovai bujhai taa vaidh sujaan ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a3e\u0a1d",ang:148,shabadId:433},{lines:["\u0a07\u0a39\u0a41 \u0a38\u0a30\u0a40\u0a30\u0a41 \u0a38\u0a2d\u0a41 \u0a27\u0a30\u0a2e\u0a41 \u0a39\u0a48 \u0a1c\u0a3f\u0a38\u0a41 \u0a05\u0a70\u0a26\u0a30\u0a3f \u0a38\u0a1a\u0a47 \u0a15\u0a40 \u0a35\u0a3f\u0a1a\u0a3f \u0a1c\u0a4b\u0a24\u0a3f \u0965","\u0a17\u0a41\u0a39\u0a1c \u0a30\u0a24\u0a28 \u0a35\u0a3f\u0a1a\u0a3f \u0a32\u0a41\u0a15\u0a3f \u0a30\u0a39\u0a47 \u0a15\u0a4b\u0a08 \u0a17\u0a41\u0a30\u0a2e\u0a41\u0a16\u0a3f \u0a38\u0a47\u0a35\u0a15\u0a41 \u0a15\u0a22\u0a48 \u0a16\u0a4b\u0a24\u0a3f \u0965"],translation:"This body is the home of Dharma; the Divine Light of the True Lord is within it.",transliteration:["eih sareer sabh dharam hai jis a(n)dhar sache kee vich jot ||","guhaj ratan vich luk rahe koiee gurmukh sevak kaddai khot ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:309,shabadId:1169},{lines:["\u0a38\u0a30\u0a40\u0a30 \u0a38\u0a30\u0a4b\u0a35\u0a30 \u0a2d\u0a40\u0a24\u0a30\u0a47 \u0a06\u0a1b\u0a48 \u0a15\u0a2e\u0a32 \u0a05\u0a28\u0a42\u0a2a \u0965","\u0a2a\u0a30\u0a2e \u0a1c\u0a4b\u0a24\u0a3f \u0a2a\u0a41\u0a30\u0a16\u0a4b\u0a24\u0a2e\u0a4b \u0a1c\u0a3e \u0a15\u0a48 \u0a30\u0a47\u0a16 \u0a28 \u0a30\u0a42\u0a2a \u0965\u0a67\u0965"],translation:"Within the pool of the body, there is an incomparably beautiful lotus flower.",transliteration:["sareer sarovar bheetare aachhai kamal anoop ||","param jot purakhotamo jaa kai rekh na roop ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a3f\u0a32\u0a3e\u0a35\u0a32",ang:857,shabadId:3213},{lines:["\u0a38\u0a3f\u0a2e\u0a30\u0a24 \u0a28\u0a3e\u0a2e\u0a41 \u0a30\u0a3f\u0a26\u0a48 \u0a38\u0a41\u0a16\u0a41 \u0a2a\u0a3e\u0a07\u0a06 \u0965","\u0a15\u0a30\u0a3f \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a2d\u0a17\u0a24\u0a02\u0a40 \u0a2a\u0a4d\u0a30\u0a17\u0a1f\u0a3e\u0a07\u0a06 \u0965"],translation:"Meditating on the Naam, the Name of the Lord, my heart is filled with peace.",transliteration:["simarat naam ridhai sukh paiaa ||","kar kirapaa bhagata(n)ee pragaTaiaa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a3e\u0a1d",ang:108,shabadId:317},{lines:["\u0a38\u0a24\u0a3f\u0a17\u0a41\u0a30 \u0a24\u0a47 \u0a17\u0a41\u0a23 \u0a0a\u0a2a\u0a1c\u0a48 \u0a1c\u0a3e \u0a2a\u0a4d\u0a30\u0a2d\u0a41 \u0a2e\u0a47\u0a32\u0a48 \u0a38\u0a4b\u0a07 \u0965","\u0a38\u0a39\u0a1c\u0a47 \u0a28\u0a3e\u0a2e\u0a41 \u0a27\u0a3f\u0a06\u0a08\u0a10 \u0a17\u0a3f\u0a06\u0a28\u0a41 \u0a2a\u0a30\u0a17\u0a1f\u0a41 \u0a39\u0a4b\u0a07 \u0965\u0a67\u0965"],translation:"Merit is obtained from the True Guru, when God causes us to meet Him.",transliteration:["satigur te gun uoopajai jaa prabh melai soi ||","sahaje naam dhiaaieeaai giaan paragaT hoi ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a06\u0a38\u0a3e",ang:428,shabadId:1633},{lines:["\u0a2e\u0a48 \u0a2e\u0a28\u0a3f \u0a24\u0a28\u0a3f \u0a2c\u0a3f\u0a30\u0a39\u0a41 \u0a05\u0a24\u0a3f \u0a05\u0a17\u0a32\u0a3e \u0a15\u0a3f\u0a09 \u0a2a\u0a4d\u0a30\u0a40\u0a24\u0a2e\u0a41 \u0a2e\u0a3f\u0a32\u0a48 \u0a18\u0a30\u0a3f \u0a06\u0a07 \u0965","\u0a1c\u0a3e \u0a26\u0a47\u0a16\u0a3e \u0a2a\u0a4d\u0a30\u0a2d\u0a41 \u0a06\u0a2a\u0a23\u0a3e \u0a2a\u0a4d\u0a30\u0a2d\u0a3f \u0a26\u0a47\u0a16\u0a3f\u0a10 \u0a26\u0a41\u0a16\u0a41 \u0a1c\u0a3e\u0a07 \u0965"],translation:"Within my mind and body is the intense pain of separation; how can my Beloved come to meet me in my home?",transliteration:["mai man tan birahu at agalaa kiau preetam milai ghar aai ||","jaa dhekhaa prabh aapanaa prabh dhekhiaai dhukh jai ||"],raag:"\u0a38\u0a3f\u0a30\u0a40 \u0a30\u0a3e\u0a17\u0a41",ang:39,shabadId:118},{lines:["\u0a2a\u0a3e\u0a30\u0a2c\u0a4d\u0a30\u0a39\u0a2e \u0a2a\u0a4d\u0a30\u0a2d \u0a2d\u0a0f \u0a15\u0a4d\u0a30\u0a3f\u0a2a\u0a3e\u0a32 \u0965","\u0a15\u0a3e\u0a30\u0a1c \u0a38\u0a17\u0a32 \u0a38\u0a35\u0a3e\u0a30\u0a47 \u0a38\u0a24\u0a3f\u0a17\u0a41\u0a30 \u0a1c\u0a2a\u0a3f \u0a1c\u0a2a\u0a3f \u0a38\u0a3e\u0a27\u0a42 \u0a2d\u0a0f \u0a28\u0a3f\u0a39\u0a3e\u0a32 \u0965\u0a67\u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965"],translation:"The Supreme Lord God has become Merciful.",transliteration:["paarabraham prabh bhe kirapaal ||","kaaraj sagal savaare satigur jap jap saadhoo bhe nihaal ||1|| rahaau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a3f\u0a32\u0a3e\u0a35\u0a32",ang:826,shabadId:3119},{lines:["\u0a10\u0a38\u0a4b \u0a38\u0a39\u0a3e\u0a08 \u0a39\u0a30\u0a3f \u0a15\u0a4b \u0a28\u0a3e\u0a2e \u0965","\u0a38\u0a3e\u0a27\u0a38\u0a70\u0a17\u0a24\u0a3f \u0a2d\u0a1c\u0a41 \u0a2a\u0a42\u0a30\u0a28 \u0a15\u0a3e\u0a2e \u0965\u0a67\u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965"],translation:"This is the sort of helper the Name of the Lord is.",transliteration:["aaiso sahaiee har ko naam ||","saadhasa(n)gat bhaj pooran kaam ||1|| rahaau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a3e\u0a32\u0a40 \u0a17\u0a09\u0a5c\u0a3e",ang:986,shabadId:3644},{lines:["\u0a2b\u0a30\u0a40\u0a26\u0a3e \u0a2d\u0a42\u0a2e\u0a3f \u0a30\u0a70\u0a17\u0a3e\u0a35\u0a32\u0a40 \u0a2e\u0a70\u0a1d\u0a3f \u0a35\u0a3f\u0a38\u0a42\u0a32\u0a3e \u0a2c\u0a3e\u0a17\u0a41 \u0965","\u0a1c\u0a4b \u0a28\u0a30 \u0a2a\u0a40\u0a30\u0a3f \u0a28\u0a3f\u0a35\u0a3e\u0a1c\u0a3f\u0a06 \u0a24\u0a3f\u0a28\u0a51\u0a3e \u0a05\u0a70\u0a1a \u0a28 \u0a32\u0a3e\u0a17 \u0965\u0a67\u0965"],translation:"Fareed, this world is beautiful, but there is a thorny garden within it.",transliteration:["fareedhaa bhoom ra(n)gaavalee ma(n)jh visoolaa baag ||","jo nar peer nivaajiaa tin(h)aa a(n)ch na laag ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a30\u0a3e\u0a2e\u0a15\u0a32\u0a40",ang:966,shabadId:3578},{lines:["\u0a2e\u0a4d\u0a30\u0a3f\u0a17 \u0a2e\u0a40\u0a28 \u0a2d\u0a4d\u0a30\u0a3f\u0a70\u0a17 \u0a2a\u0a24\u0a70\u0a17 \u0a15\u0a41\u0a70\u0a1a\u0a30 \u0a0f\u0a15 \u0a26\u0a4b\u0a16 \u0a2c\u0a3f\u0a28\u0a3e\u0a38 \u0965","\u0a2a\u0a70\u0a1a \u0a26\u0a4b\u0a16 \u0a05\u0a38\u0a3e\u0a27 \u0a1c\u0a3e \u0a2e\u0a39\u0a3f \u0a24\u0a3e \u0a15\u0a40 \u0a15\u0a47\u0a24\u0a15 \u0a06\u0a38 \u0965\u0a67\u0965"],translation:"The deer, the fish, the bumble bee, the moth and the elephant are destroyed, each for a single defect.",transliteration:["mirag meen bhira(n)g pata(n)g ku(n)char ek dhokh binaas ||","pa(n)ch dhokh asaadh jaa meh taa kee ketak aas ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a06\u0a38\u0a3e",ang:486,shabadId:1810},{lines:["\u0a2a\u0a4d\u0a30\u0a2d \u0a26\u0a3e\u0a24\u0a09 \u0a26\u0a3e\u0a24\u0a3e\u0a30 \u0a2a\u0a30\u0a75\u0a3f\u0a09 \u0a1c\u0a3e\u0a1a\u0a15\u0a41 \u0a07\u0a15\u0a41 \u0a38\u0a30\u0a28\u0a3e \u0965","\u0a2e\u0a3f\u0a32\u0a48 \u0a26\u0a3e\u0a28\u0a41 \u0a38\u0a70\u0a24 \u0a30\u0a47\u0a28 \u0a1c\u0a47\u0a39 \u0a32\u0a17\u0a3f \u0a2d\u0a09\u0a1c\u0a32\u0a41 \u0a24\u0a30\u0a28\u0a3e \u0965"],translation:"I am a beggar; I seek the Sanctuary of God, the Giver of givers.",transliteration:["prabh dhaatau dhaataar pariyeau jaachak ik saranaa ||","milai dhaan sa(n)t ren jeh lag bhaujal taranaa ||"],raag:"\u0a38\u0a35\u0a2f\u0a47 \u0a38\u0a4d\u0a30\u0a40 \u0a2e\u0a41\u0a16 \u0a2c\u0a3e\u0a15 \u0a2e\u0a39\u0a32\u0a3e \u0a6b",ang:1386,shabadId:5343},{lines:["\u0a35\u0a3f\u0a38\u0a3e\u0a30\u0a47\u0a26\u0a47 \u0a2e\u0a30\u0a3f \u0a17\u0a0f \u0a2e\u0a30\u0a3f \u0a2d\u0a3f \u0a28 \u0a38\u0a15\u0a39\u0a3f \u0a2e\u0a42\u0a32\u0a3f \u0965","\u0a35\u0a47\u0a2e\u0a41\u0a16 \u0a39\u0a4b\u0a0f \u0a30\u0a3e\u0a2e \u0a24\u0a47 \u0a1c\u0a3f\u0a09 \u0a24\u0a38\u0a15\u0a30 \u0a09\u0a2a\u0a30\u0a3f \u0a38\u0a42\u0a32\u0a3f \u0965\u0a68\u0965"],translation:"Those who forget the Lord die, but they cannot die a complete death.",transliteration:["visaaredhe mar ge mar bh na sakeh mool ||","vemukh hoe raam te jiau tasakar upar sool ||2||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:319,shabadId:1241},{lines:["\u0a0f\u0a15\u0a2e \u0a0f\u0a15\u0a70\u0a15\u0a3e\u0a30\u0a41 \u0a28\u0a3f\u0a30\u0a3e\u0a32\u0a3e \u0965","\u0a05\u0a2e\u0a30\u0a41 \u0a05\u0a1c\u0a4b\u0a28\u0a40 \u0a1c\u0a3e\u0a24\u0a3f \u0a28 \u0a1c\u0a3e\u0a32\u0a3e \u0965"],translation:"The First Day: The One Universal Creator is unique,",transliteration:["ekam eka(n)kaar niraalaa ||","amar ajonee jaat na jaalaa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a3f\u0a32\u0a3e\u0a35\u0a32",ang:838,shabadId:3150},{lines:["\u0a1c\u0a3f\u0a28 \u0a39\u0a30\u0a3f \u0a39\u0a3f\u0a30\u0a26\u0a48 \u0a38\u0a47\u0a35\u0a3f\u0a06 \u0a24\u0a3f\u0a28 \u0a39\u0a30\u0a3f \u0a06\u0a2a\u0a3f \u0a2e\u0a3f\u0a32\u0a3e\u0a0f \u0965","\u0a17\u0a41\u0a23 \u0a15\u0a40 \u0a38\u0a3e\u0a1d\u0a3f \u0a24\u0a3f\u0a28 \u0a38\u0a3f\u0a09 \u0a15\u0a30\u0a40 \u0a38\u0a2d\u0a3f \u0a05\u0a35\u0a17\u0a23 \u0a38\u0a2c\u0a26\u0a3f \u0a1c\u0a32\u0a3e\u0a0f \u0965"],translation:"One who serves the Lord with all his heart - the Lord Himself unites him with Himself.",transliteration:["jin har hiradhai seviaa tin har aap milaae ||","gun kee saajh tin siau karee sabh avagan sabadh jalaae ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:303,shabadId:1141},{lines:["\u0a38\u0a3e\u0a27\u0a42 \u0a38\u0a70\u0a17\u0a3f \u0a38\u0a3f\u0a16\u0a3e\u0a07\u0a13 \u0a28\u0a3e\u0a2e\u0a41 \u0965","\u0a38\u0a30\u0a2c \u0a2e\u0a28\u0a4b\u0a30\u0a25 \u0a2a\u0a42\u0a30\u0a28 \u0a15\u0a3e\u0a2e \u0965"],translation:"In the Saadh Sangat, the Company of the Holy, the Naam is learned;",transliteration:["saadhoo sa(n)g sikhaio naam ||","sarab manorath pooran kaam ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a06\u0a38\u0a3e",ang:393,shabadId:1527},{lines:["\u0a1c\u0a3f\u0a39 \u0a2e\u0a41\u0a16 \u0a2c\u0a47\u0a26\u0a41 \u0a17\u0a3e\u0a07\u0a24\u0a4d\u0a30\u0a40 \u0a28\u0a3f\u0a15\u0a38\u0a48 \u0a38\u0a4b \u0a15\u0a3f\u0a09 \u0a2c\u0a4d\u0a30\u0a39\u0a2e\u0a28\u0a41 \u0a2c\u0a3f\u0a38\u0a30\u0a41 \u0a15\u0a30\u0a48 \u0965","\u0a1c\u0a3e \u0a15\u0a48 \u0a2a\u0a3e\u0a07 \u0a1c\u0a17\u0a24\u0a41 \u0a38\u0a2d\u0a41 \u0a32\u0a3e\u0a17\u0a48 \u0a38\u0a4b \u0a15\u0a3f\u0a09 \u0a2a\u0a70\u0a21\u0a3f\u0a24\u0a41 \u0a39\u0a30\u0a3f \u0a28 \u0a15\u0a39\u0a48 \u0965\u0a67\u0965"],translation:"O Brahmin, how can you forget the One, from whose mouth the Vedas and the Gayitri prayer issured forth?",transliteration:["jeh mukh bedh gaitree nikasai so kiau brahaman bisar karai ||","jaa kai pai jagat sabh laagai so kiau pa(n)ddit har na kahai ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a30\u0a3e\u0a2e\u0a15\u0a32\u0a40",ang:970,shabadId:3596},{lines:["\u0a24\u0a3f\u0a38\u0a41 \u0a17\u0a41\u0a30 \u0a15\u0a09 \u0a39\u0a09 \u0a35\u0a3e\u0a30\u0a3f\u0a06 \u0a1c\u0a3f\u0a28\u0a3f \u0a39\u0a30\u0a3f \u0a15\u0a40 \u0a39\u0a30\u0a3f \u0a15\u0a25\u0a3e \u0a38\u0a41\u0a23\u0a3e\u0a08 \u0965","\u0a24\u0a3f\u0a38\u0a41 \u0a17\u0a41\u0a30 \u0a15\u0a09 \u0a38\u0a26 \u0a2c\u0a32\u0a3f\u0a39\u0a3e\u0a30\u0a23\u0a48 \u0a1c\u0a3f\u0a28\u0a3f \u0a39\u0a30\u0a3f \u0a38\u0a47\u0a35\u0a3e \u0a2c\u0a23\u0a24 \u0a2c\u0a23\u0a3e\u0a08 \u0965"],translation:"I am a sacrifice to the Guru, who recites the sermon of the Lord's Teachings.",transliteration:["tis gur kau hau vaariaa jin har kee har kathaa sunaiee ||","tis gur kau sadh balihaaranai jin har sevaa banat banaiee ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a35\u0a21\u0a39\u0a70\u0a38\u0a41",ang:587,shabadId:2218},{lines:["\u0a28\u0a3e\u0a28\u0a15 \u0a32\u0a3f\u0a32\u0a3e\u0a30\u0a3f \u0a32\u0a3f\u0a16\u0a3f\u0a06 \u0a38\u0a4b\u0a07 \u0965","\u0a2e\u0a47\u0a1f\u0a3f \u0a28 \u0a38\u0a3e\u0a15\u0a48 \u0a15\u0a4b\u0a07 \u0965"],translation:"O Nanak, that destiny which is pre-ordained and written on one's forehead",transliteration:["naanak lilaar likhiaa soi ||","meT na saakai koi ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a3e\u0a1d",ang:144,shabadId:406},{lines:["\u0a2e\u0a28 \u0a30\u0a47 \u0a15\u0a39\u0a3e \u0a2d\u0a07\u0a13 \u0a24\u0a48 \u0a2c\u0a09\u0a30\u0a3e \u0965","\u0a05\u0a39\u0a3f\u0a28\u0a3f\u0a38\u0a3f \u0a05\u0a09\u0a27 \u0a18\u0a1f\u0a48 \u0a28\u0a39\u0a40 \u0a1c\u0a3e\u0a28\u0a48 \u0a2d\u0a07\u0a13 \u0a32\u0a4b\u0a2d \u0a38\u0a70\u0a17\u0a3f \u0a39\u0a09\u0a30\u0a3e \u0965\u0a67\u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965"],translation:"O mind, why have you gone crazy?",transliteration:["man re kahaa bhio tai bauraa ||","ahinis aaudh ghaTai nahee jaanai bhio lobh sa(n)g hauraa ||1|| rahaau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:220,shabadId:700},{lines:["\u0a24\u0a09 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a24\u0a47 \u0a2e\u0a3e\u0a30\u0a17\u0a41 \u0a2a\u0a3e\u0a08\u0a10 \u0965","\u0a2a\u0a4d\u0a30\u0a2d \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a24\u0a47 \u0a28\u0a3e\u0a2e\u0a41 \u0a27\u0a3f\u0a06\u0a08\u0a10 \u0965"],translation:"By Your Grace, we find the Way.",transliteration:["tau kirapaa te maarag paieeaai ||","prabh kirapaa te naam dhiaaieeaai ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:180,shabadId:534},{lines:["\u0a39\u0a30\u0a3f \u0a15\u0a3e \u0a38\u0a70\u0a24\u0a41 \u0a38\u0a24\u0a17\u0a41\u0a30\u0a41 \u0a38\u0a24 \u0a2a\u0a41\u0a30\u0a16\u0a3e \u0a1c\u0a4b \u0a2c\u0a4b\u0a32\u0a48 \u0a39\u0a30\u0a3f \u0a39\u0a30\u0a3f \u0a2c\u0a3e\u0a28\u0a40 \u0965","\u0a1c\u0a4b \u0a1c\u0a4b \u0a15\u0a39\u0a48 \u0a38\u0a41\u0a23\u0a48 \u0a38\u0a4b \u0a2e\u0a41\u0a15\u0a24\u0a3e \u0a39\u0a2e \u0a24\u0a3f\u0a38 \u0a15\u0a48 \u0a38\u0a26 \u0a15\u0a41\u0a30\u0a2c\u0a3e\u0a28\u0a40 \u0965\u0a67\u0965"],translation:"The True Guru is the Lord's Saint, the True Being, who chants the Bani of the Lord, Har, Har.",transliteration:["har kaa sa(n)t satagur sat purakhaa jo bolai har har baanee ||","jo jo kahai sunai so mukataa ham tis kai sadh kurabaanee ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a27\u0a28\u0a3e\u0a38\u0a30\u0a40",ang:667,shabadId:2545},{lines:["\u0a2e\u0a48 \u0a2e\u0a28\u0a3f \u0a24\u0a28\u0a3f \u0a2a\u0a4d\u0a30\u0a47\u0a2e\u0a41 \u0a05\u0a17\u0a2e \u0a20\u0a3e\u0a15\u0a41\u0a30 \u0a15\u0a3e \u0a16\u0a3f\u0a28\u0a41 \u0a16\u0a3f\u0a28\u0a41 \u0a38\u0a30\u0a27\u0a3e \u0a2e\u0a28\u0a3f \u0a2c\u0a39\u0a41\u0a24\u0a41 \u0a09\u0a20\u0a08\u0a06 \u0965","\u0a17\u0a41\u0a30 \u0a26\u0a47\u0a16\u0a47 \u0a38\u0a30\u0a27\u0a3e \u0a2e\u0a28 \u0a2a\u0a42\u0a30\u0a40 \u0a1c\u0a3f\u0a09 \u0a1a\u0a3e\u0a24\u0a4d\u0a30\u0a3f\u0a15 \u0a2a\u0a4d\u0a30\u0a3f\u0a09 \u0a2a\u0a4d\u0a30\u0a3f\u0a09 \u0a2c\u0a42\u0a70\u0a26 \u0a2e\u0a41\u0a16\u0a3f \u0a2a\u0a08\u0a06 \u0965\u0a67\u0965"],translation:"My mind and body are filled with love for my Inaccessible Lord and Master. Each and every instant, I am filled with immense faith and devotion.",transliteration:["mai man tan prem agam Thaakur kaa khin khin saradhaa man bahut uThieeaa ||","gur dhekhe saradhaa man pooree jiau chaatirak priau priau boo(n)dh mukh pieeaa ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a3f\u0a32\u0a3e\u0a35\u0a32",ang:836,shabadId:3147},{lines:["\u0a39\u0a30\u0a3f \u0a39\u0a30\u0a3f \u0a28\u0a3e\u0a2e\u0a41 \u0a38\u0a26\u0a3e \u0a38\u0a26 \u0a1c\u0a3e\u0a2a\u0a3f \u0965","\u0a27\u0a3e\u0a30\u0a3f \u0a05\u0a28\u0a41\u0a17\u0a4d\u0a30\u0a39\u0a41 \u0a2a\u0a3e\u0a30\u0a2c\u0a4d\u0a30\u0a39\u0a2e \u0a38\u0a41\u0a06\u0a2e\u0a40 \u0a35\u0a38\u0a26\u0a40 \u0a15\u0a40\u0a28\u0a40 \u0a06\u0a2a\u0a3f \u0965\u0a67\u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965"],translation:"Chant the Name of the Lord, Har, Har, forever and ever.",transliteration:["har har naam sadhaa sadh jaap ||","dhaar anugrahu paarabraham suaamee vasadhee keenee aap ||1|| rahaau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a1f\u0a4b\u0a21\u0a40",ang:714,shabadId:2736},{lines:["\u0a17\u0a3e\u0a08 \u0a2a\u0a41\u0a24\u0a3e \u0a28\u0a3f\u0a30\u0a27\u0a28\u0a3e \u0a2a\u0a70\u0a25\u0a40 \u0a1a\u0a3e\u0a15\u0a30\u0a41 \u0a39\u0a4b\u0a07 \u0965\u0a68\u0965"],translation:"the cow's calves, the poor, the travellers and the servants. ||2||",transliteration:["gaiee putaa niradhanaa pa(n)thee chaakar hoi ||2||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a32\u0a3e\u0a30",ang:1279,shabadId:4607},{lines:["\u0a07\u0a15\u0a41 \u0a16\u0a3f\u0a28\u0a41 \u0a39\u0a30\u0a3f \u0a2a\u0a4d\u0a30\u0a2d\u0a3f \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a27\u0a3e\u0a30\u0a40 \u0a17\u0a41\u0a28 \u0a17\u0a3e\u0a0f \u0a30\u0a38\u0a15 \u0a30\u0a38\u0a40\u0a15 \u0965","\u0a17\u0a3e\u0a35\u0a24 \u0a38\u0a41\u0a28\u0a24 \u0a26\u0a4b\u0a0a \u0a2d\u0a0f \u0a2e\u0a41\u0a15\u0a24\u0a47 \u0a1c\u0a3f\u0a28\u0a3e \u0a17\u0a41\u0a30\u0a2e\u0a41\u0a16\u0a3f \u0a16\u0a3f\u0a28\u0a41 \u0a39\u0a30\u0a3f \u0a2a\u0a40\u0a15 \u0965\u0a67\u0965"],translation:"The Lord God showered me with His Mercy for an instant; I sing His Glorious Praises with joyous love and delight.",transliteration:["eik khin har prabh kirapaa dhaaree gun gaae rasak raseek ||","gaavat sunat dhouoo bhe mukate jinaa gurmukh khin har peek ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2a\u0a4d\u0a30\u0a2d\u0a3e\u0a24\u0a40",ang:1335,shabadId:4857},{lines:["\u0a06\u0a35\u0a23 \u0a1c\u0a3e\u0a23\u0a3e \u0a28\u0a3e \u0a25\u0a40\u0a10 \u0a28\u0a3f\u0a1c \u0a18\u0a30\u0a3f \u0a35\u0a3e\u0a38\u0a3e \u0a39\u0a4b\u0a07 \u0965","\u0a38\u0a1a\u0a41 \u0a16\u0a1c\u0a3e\u0a28\u0a3e \u0a2c\u0a16\u0a38\u0a3f\u0a06 \u0a06\u0a2a\u0a47 \u0a1c\u0a3e\u0a23\u0a48 \u0a38\u0a4b\u0a07 \u0965\u0a67\u0965"],translation:"Coming and going in reincarnation no longer happens, when one dwells in the home of the self within.",transliteration:["aavan jaanaa naa theeaai nij ghar vaasaa hoi ||","sach khajaanaa bakhasiaa aape jaanai soi ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a3e\u0a30\u0a42",ang:993,shabadId:3669},{lines:["\u0a28\u0a3e\u0a2e\u0a3f \u0a30\u0a24\u0a47 \u0a15\u0a41\u0a32\u0a3e\u0a02 \u0a15\u0a3e \u0a15\u0a30\u0a39\u0a3f \u0a09\u0a27\u0a3e\u0a30\u0a41 \u0965","\u0a38\u0a3e\u0a1a\u0a40 \u0a2c\u0a3e\u0a23\u0a40 \u0a28\u0a3e\u0a2e \u0a2a\u0a3f\u0a06\u0a30\u0a41 \u0965"],translation:"Those who are imbued with the Naam, the Name of the Lord - their generations are redeemed and saved.",transliteration:["naam rate kulaa(n) kaa kareh udhaar ||","saachee baanee naam piaar ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a38\u0a70\u0a24",ang:1174,shabadId:4179},{lines:["\u0a38\u0a47 \u0a38\u0a1a\u0a3f \u0a32\u0a3e\u0a17\u0a47 \u0a1c\u0a4b \u0a24\u0a41\u0a27\u0a41 \u0a2d\u0a3e\u0a0f \u0965","\u0a38\u0a26\u0a3e \u0a38\u0a1a\u0a41 \u0a38\u0a47\u0a35\u0a39\u0a3f \u0a38\u0a39\u0a1c \u0a38\u0a41\u0a2d\u0a3e\u0a0f \u0965"],translation:"Those who please You are linked to the Truth.",transliteration:["se sach laage jo tudh bhaae ||","sadhaa sach seveh sahaj subhaae ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2e\u0a3e\u0a1d",ang:119,shabadId:337},{lines:["\u0a15\u0a2c\u0a40\u0a30 \u0a2e\u0a47\u0a30\u0a40 \u0a1c\u0a3e\u0a24\u0a3f \u0a15\u0a09 \u0a38\u0a2d\u0a41 \u0a15\u0a4b \u0a39\u0a38\u0a28\u0a47\u0a39\u0a3e\u0a30\u0a41 \u0965","\u0a2c\u0a32\u0a3f\u0a39\u0a3e\u0a30\u0a40 \u0a07\u0a38 \u0a1c\u0a3e\u0a24\u0a3f \u0a15\u0a09 \u0a1c\u0a3f\u0a39 \u0a1c\u0a2a\u0a3f\u0a13 \u0a38\u0a3f\u0a30\u0a1c\u0a28\u0a39\u0a3e\u0a30\u0a41 \u0965\u0a68\u0965"],translation:"Kabeer, everyone laughs at my social class.",transliteration:["kabeer meree jaat kau sabh ko hasanehaar ||","balihaaree is jaat kau jeh japio sirajanahaar ||2||"],raag:"\u0a38\u0a32\u0a4b\u0a15 \u0a2d\u0a17\u0a24 \u0a15\u0a2c\u0a40\u0a30 \u0a1c\u0a40\u0a09 \u0a15\u0a47",ang:1364,shabadId:4970},{lines:["\u0a1d\u0a3e\u0a32\u0a3e\u0a18\u0a47 \u0a09\u0a20\u0a3f \u0a28\u0a3e\u0a2e\u0a41 \u0a1c\u0a2a\u0a3f \u0a28\u0a3f\u0a38\u0a3f \u0a2c\u0a3e\u0a38\u0a41\u0a30 \u0a06\u0a30\u0a3e\u0a27\u0a3f \u0965","\u0a15\u0a3e\u0a30\u0a4d\u0a39\u0a3e \u0a24\u0a41\u0a1d\u0a48 \u0a28 \u0a2c\u0a3f\u0a06\u0a2a\u0a08 \u0a28\u0a3e\u0a28\u0a15 \u0a2e\u0a3f\u0a1f\u0a48 \u0a09\u0a2a\u0a3e\u0a27\u0a3f \u0965\u0a67\u0965"],translation:"Rise early in the morning, and chant the Naam; worship and adore the Lord, night and day.",transliteration:["jhaalaaghe uTh naam jap nis baasur aaraadh ||","kaarhaa tujhai na biaapiee naanak miTai upaadh ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:255,shabadId:808},{lines:["\u0a06\u0a17\u0a48 \u0a38\u0a41\u0a16\u0a41 \u0a2e\u0a47\u0a30\u0a47 \u0a2e\u0a40\u0a24\u0a3e \u0965","\u0a2a\u0a3e\u0a1b\u0a47 \u0a06\u0a28\u0a26\u0a41 \u0a2a\u0a4d\u0a30\u0a2d\u0a3f \u0a15\u0a40\u0a24\u0a3e \u0965"],translation:"Peace in this world, O my friends,",transliteration:["aagai sukh mere meetaa ||","paachhe aanadh prabh keetaa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a38\u0a4b\u0a30\u0a20\u0a3f",ang:629,shabadId:2386},{lines:["\u0a38\u0a39\u0a1c\u0a48 \u0a28\u0a4b \u0a38\u0a2d \u0a32\u0a4b\u0a1a\u0a26\u0a40 \u0a2c\u0a3f\u0a28\u0a41 \u0a17\u0a41\u0a30 \u0a2a\u0a3e\u0a07\u0a06 \u0a28 \u0a1c\u0a3e\u0a07 \u0965","\u0a2a\u0a5c\u0a3f \u0a2a\u0a5c\u0a3f \u0a2a\u0a70\u0a21\u0a3f\u0a24 \u0a1c\u0a4b\u0a24\u0a15\u0a40 \u0a25\u0a15\u0a47 \u0a2d\u0a47\u0a16\u0a40 \u0a2d\u0a30\u0a2e\u0a3f \u0a2d\u0a41\u0a32\u0a3e\u0a07 \u0965"],translation:"Everyone longs to be centered and balanced, but without the Guru, no one can.",transliteration:["sahajai no sabh lochadhee bin gur paiaa na jai ||","paR paR pa(n)ddit jotakee thake bhekhee bharam bhulai ||"],raag:"\u0a38\u0a3f\u0a30\u0a40 \u0a30\u0a3e\u0a17\u0a41",ang:68,shabadId:177},{lines:["\u0a09\u0a32\u0a1f\u0a3f \u0a1c\u0a3e\u0a24\u0a3f \u0a15\u0a41\u0a32 \u0a26\u0a4b\u0a0a \u0a2c\u0a3f\u0a38\u0a3e\u0a30\u0a40 \u0965","\u0a38\u0a41\u0a70\u0a28 \u0a38\u0a39\u0a1c \u0a2e\u0a39\u0a3f \u0a2c\u0a41\u0a28\u0a24 \u0a39\u0a2e\u0a3e\u0a30\u0a40 \u0965\u0a67\u0965"],translation:"Turning away from the world, I have forgotten both my social class and ancestry.",transliteration:["aulaT jaat kul dhouoo bisaaree ||","su(n)n sahaj meh bunat hamaaree ||1||"],raag:"\u0a30\u0a3e\u0a17\u0a41  \u0a2d\u0a48\u0a30\u0a73",ang:1158,shabadId:4132},{lines:["\u0a1c\u0a3f\u0a09 \u0a1c\u0a3e\u0a28\u0a39\u0a41 \u0a24\u0a3f\u0a09 \u0a30\u0a3e\u0a16\u0a41 \u0a39\u0a30\u0a3f \u0a2a\u0a4d\u0a30\u0a2d \u0a24\u0a47\u0a30\u0a3f\u0a06 \u0965","\u0a15\u0a47\u0a24\u0a47 \u0a17\u0a28\u0a09 \u0a05\u0a38\u0a70\u0a16 \u0a05\u0a35\u0a17\u0a23 \u0a2e\u0a47\u0a30\u0a3f\u0a06 \u0965"],translation:"Save me, any way You can; O Lord God, I am Yours.",transliteration:["jiau jaanahu tiau raakh har prabh teriaa ||","kete ganau asa(n)kh avagan meriaa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a1c\u0a48\u0a24\u0a38\u0a30\u0a40",ang:704,shabadId:2673},{lines:["\u0a05\u0a2a\u0a23\u0a47 \u0a2c\u0a3e\u0a32\u0a15 \u0a06\u0a2a\u0a3f \u0a30\u0a16\u0a3f\u0a05\u0a28\u0a41 \u0a2a\u0a3e\u0a30\u0a2c\u0a4d\u0a30\u0a39\u0a2e \u0a17\u0a41\u0a30\u0a26\u0a47\u0a35 \u0965","\u0a38\u0a41\u0a16 \u0a38\u0a3e\u0a02\u0a24\u0a3f \u0a38\u0a39\u0a1c \u0a06\u0a28\u0a26 \u0a2d\u0a0f \u0a2a\u0a42\u0a30\u0a28 \u0a2d\u0a08 \u0a38\u0a47\u0a35 \u0965\u0a67\u0965 \u0a30\u0a39\u0a3e\u0a09 \u0965"],translation:"The Supreme Lord God, through the Divine Guru, has Himself protected and preserved His children.",transliteration:["apane baalak aap rakhian paarabraham gurdhev ||","sukh saa(n)t sahaj aanadh bhe pooran bhiee sev ||1|| rahaau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a3f\u0a32\u0a3e\u0a35\u0a32",ang:819,shabadId:3086},{lines:["\u0a05\u0a24\u0a3f \u0a2a\u0a4d\u0a30\u0a40\u0a24\u0a2e \u0a2e\u0a28 \u0a2e\u0a4b\u0a39\u0a28\u0a3e \u0a18\u0a1f \u0a38\u0a4b\u0a39\u0a28\u0a3e \u0a2a\u0a4d\u0a30\u0a3e\u0a28 \u0a05\u0a27\u0a3e\u0a30\u0a3e \u0a30\u0a3e\u0a2e \u0965","\u0a38\u0a41\u0a70\u0a26\u0a30 \u0a38\u0a4b\u0a2d\u0a3e \u0a32\u0a3e\u0a32 \u0a17\u0a4b\u0a2a\u0a3e\u0a32 \u0a26\u0a07\u0a06\u0a32 \u0a15\u0a40 \u0a05\u0a2a\u0a30 \u0a05\u0a2a\u0a3e\u0a30\u0a3e \u0a30\u0a3e\u0a2e \u0965"],translation:"He is dear to me; He fascinates my mind; He is the ornament of my heart, the support of the breath of life.",transliteration:["at preetam man mohanaa ghaT sohanaa praan adhaaraa raam ||","su(n)dhar sobhaa laal gopaal dhiaal kee apar apaaraa raam ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a3f\u0a39\u0a3e\u0a17\u0a5c\u0a3e",ang:542,shabadId:2073},{lines:["\u0a2e\u0a28 \u0a2e\u0a47\u0a30\u0a3f\u0a06 \u0a24\u0a42 \u0a38\u0a26\u0a3e \u0a38\u0a1a\u0a41 \u0a38\u0a2e\u0a3e\u0a32\u0a3f \u0a1c\u0a40\u0a09 \u0965","\u0a06\u0a2a\u0a23\u0a48 \u0a18\u0a30\u0a3f \u0a24\u0a42 \u0a38\u0a41\u0a16\u0a3f \u0a35\u0a38\u0a39\u0a3f \u0a2a\u0a4b\u0a39\u0a3f \u0a28 \u0a38\u0a15\u0a48 \u0a1c\u0a2e\u0a15\u0a3e\u0a32\u0a41 \u0a1c\u0a40\u0a09 \u0965"],translation:"O my mind, contemplate the True Lord forever.",transliteration:["man meriaa too sadhaa sach samaal jeeau ||","aapanai ghar too sukh vaseh poh na sakai jamakaal jeeau ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a35\u0a21\u0a39\u0a70\u0a38\u0a41",ang:569,shabadId:2174},{lines:["\u0a0f \u0a2e\u0a28\u0a3e \u0a05\u0a24\u0a3f \u0a32\u0a4b\u0a2d\u0a40\u0a06 \u0a28\u0a3f\u0a24 \u0a32\u0a4b\u0a2d\u0a47 \u0a30\u0a3e\u0a24\u0a3e \u0965","\u0a2e\u0a3e\u0a07\u0a06 \u0a2e\u0a28\u0a38\u0a3e \u0a2e\u0a4b\u0a39\u0a23\u0a40 \u0a26\u0a39 \u0a26\u0a3f\u0a38 \u0a2b\u0a3f\u0a30\u0a3e\u0a24\u0a3e \u0965"],translation:"O my utterly greedy mind, you are constantly engrossed in greed.",transliteration:["e manaa at lobheeaa nit lobhe raataa ||","maiaa manasaa mohanee dheh dhis firaataa ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a42\u0a1c\u0a30\u0a40",ang:514,shabadId:1921},{lines:["\u0a2e\u0a3e\u0a24\u0a3e \u0a2a\u0a4d\u0a30\u0a40\u0a24\u0a3f \u0a15\u0a30\u0a47 \u0a2a\u0a41\u0a24\u0a41 \u0a16\u0a3e\u0a07 \u0965","\u0a2e\u0a40\u0a28\u0a47 \u0a2a\u0a4d\u0a30\u0a40\u0a24\u0a3f \u0a2d\u0a08 \u0a1c\u0a32\u0a3f \u0a28\u0a3e\u0a07 \u0965"],translation:"The mother loves to see her son eat.",transliteration:["maataa preet kare put khai ||","meene preet bhiee jal nai ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a09\u0a5c\u0a40",ang:164,shabadId:491},{lines:["\u0a2b\u0a30\u0a40\u0a26\u0a3e \u0a2d\u0a42\u0a2e\u0a3f \u0a30\u0a70\u0a17\u0a3e\u0a35\u0a32\u0a40 \u0a2e\u0a70\u0a1d\u0a3f \u0a35\u0a3f\u0a38\u0a42\u0a32\u0a3e \u0a2c\u0a3e\u0a17 \u0965","\u0a1c\u0a4b \u0a1c\u0a28 \u0a2a\u0a40\u0a30\u0a3f \u0a28\u0a3f\u0a35\u0a3e\u0a1c\u0a3f\u0a06 \u0a24\u0a3f\u0a70\u0a28\u0a51\u0a3e \u0a05\u0a70\u0a1a \u0a28 \u0a32\u0a3e\u0a17 \u0965\u0a6e\u0a68\u0965"],translation:"Fareed, in the midst of this beautiful earth, there is a garden of thorns.",transliteration:["fareedhaa bhoom ra(n)gaavalee ma(n)jh visoolaa baag ||","jo jan peer nivaajiaa ti(n)n(h)aa a(n)ch na laag ||82||"],raag:"\u0a38\u0a32\u0a4b\u0a15 \u0a38\u0a47\u0a16 \u0a2b\u0a30\u0a40\u0a26 \u0a15",ang:1382,shabadId:5290},{lines:["\u0a2d\u0a17\u0a24\u0a3f \u0a35\u0a1b\u0a32\u0a41 \u0a39\u0a30\u0a3f \u0a35\u0a38\u0a48 \u0a2e\u0a28\u0a3f \u0a06\u0a07 \u0965","\u0a17\u0a41\u0a30 \u0a15\u0a3f\u0a30\u0a2a\u0a3e \u0a24\u0a47 \u0a38\u0a39\u0a1c \u0a38\u0a41\u0a2d\u0a3e\u0a07 \u0965"],translation:"The Lord is the Lover of His devotees; He dwells within their minds,",transliteration:["bhagat vachhal har vasai man aai ||","gur kirapaa te sahaj subhai ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a2c\u0a38\u0a70\u0a24",ang:1173,shabadId:4175},{lines:["\u0a1c\u0a3f \u0a38\u0a24\u0a3f\u0a17\u0a41\u0a30\u0a41 \u0a38\u0a47\u0a35\u0a47 \u0a06\u0a2a\u0a23\u0a3e \u0a24\u0a3f\u0a38 \u0a28\u0a4b \u0a2a\u0a42\u0a1c\u0a47 \u0a38\u0a2d\u0a41 \u0a15\u0a4b\u0a07 \u0965","\u0a38\u0a2d\u0a28\u0a3e \u0a09\u0a2a\u0a3e\u0a35\u0a3e \u0a38\u0a3f\u0a30\u0a3f \u0a09\u0a2a\u0a3e\u0a09 \u0a39\u0a48 \u0a39\u0a30\u0a3f \u0a28\u0a3e\u0a2e\u0a41 \u0a2a\u0a30\u0a3e\u0a2a\u0a24\u0a3f \u0a39\u0a4b\u0a07 \u0965"],translation:"One who serves his True Guru, is worshipped by everyone.",transliteration:["j satigur seve aapanaa tis no pooje sabh koi ||","sabhanaa upaavaa sir upaau hai har naam paraapat hoi ||"],raag:"\u0a30\u0a3e\u0a17\u0a41 \u0a17\u0a42\u0a1c\u0a30\u0a40",ang:511,shabadId:1901}]}},1699,[]);
